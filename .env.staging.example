# Staging Environment Configuration Template
# Copy to .env.staging or configure in GitHub Actions Secrets

# Database Configuration (Placeholder)
MONGODB_URI=mongodb+srv://staging_user:change_me_staging_password@cluster.mongodb.net/WhiteCavesStaging?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://staging_user:change_me_staging_password@cluster.mongodb.net/WhiteCavesStaging?retryWrites=true&w=majority

NODE_ENV=test
VITE_MODE=staging

# Firebase Configuration (Staging)
VITE_FIREBASE_API_KEY=staging-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=white-caves-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=white-caves-staging

# Test Configuration
TEST_DATA_SOURCE=staging
TEST_ISOLATION_ENABLED=true
TEST_DATA_TTL=48h

# API Configuration
VITE_API_URL=http://localhost:5000/api
PORT=5000

# Other Services
VITE_STRIPE_KEY=pk_test_staging_placeholder
VITE_WHATSAPP_API_URL=https://staging-api.whatsapp.com

# AI Assistant Configurations
ZOE_AI_MODEL=deepseek
DEEPSEEK_API_KEY=sk_test_placeholder_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000
