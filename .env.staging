# Staging Environment Configuration
# Database Configuration - CHOOSE ONE OPTION:

# OPTION 1: Use existing Atlas production cluster (ACTIVE)
# Connected to: arslanmalikgoraha_db_user@whitecavesdb.opetsag.mongodb.net
MONGODB_URI="mongodb+srv://arslanmalikgoraha_db_user:WhiteCaves2024@whitecavesdb.opetsag.mongodb.net/WhiteCavesDB?retryWrites=true&w=majority"

# OPTION 2: Use local MongoDB (development)
# Uncomment if you have MongoDB running locally on port 27017
# MONGODB_LOCAL=mongodb://localhost:27017/white_caves_test

# OPTION 3: Use production Atlas cluster (if available)
# Uncomment if you want to test against production cluster
# MONGODB_ATLAS_URI=mongodb+srv://username:password@white-caves.mongodb.net/white_caves?retryWrites=true&w=majority
NODE_ENV=test
VITE_MODE=staging

# Database Connection Fallback Strategy
# If primary MONGODB_URI is empty, scripts will try in this order:
# 1. MONGODB_URI (Atlas staging)
# 2. MONGODB_ATLAS_URI (production or other Atlas cluster)
# 3. MONGODB_LOCAL (local development MongoDB)
# 4. mongodb://localhost:27017/white_caves_test (hardcoded fallback)

# Firebase Configuration (optional for unit tests)
VITE_FIREBASE_API_KEY=staging-api-key
VITE_FIREBASE_AUTH_DOMAIN=white-caves-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=white-caves-staging

# Test Configuration
