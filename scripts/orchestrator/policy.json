    },
    "approval": {
      "continuous": false,
      "useSubagents": true,
      "askBetweenTasks": true,
      "hardStopOnly": false
    }
  },
  "autonomousDefault": false,
  "hardStops": {
    "stopOnTestFailure": true,
    "stopOnLintFailure": true,
    "stopOnBuildFailure": true,
    "stopOnPolicyMismatch": true
  },
  "registryPath": "plans/SUBAGENT_REGISTRY_150.json",
  "agentMesh": {
    "totalAgents": 150,
    "freeAgentCount": 100,
    "premiumAgentCount": 50,
    "squads": 10,
    "squadSize": 10,
    "squadLeads": 10,
    "description": "100 junior/specialist free-model agents + 50 senior/decision-maker premium agents across 10 squads"
  },
  "wavePlanning": {
    "formula": "(freeReadiness >= 100%) AND (squadSynthScore >= 80%)",
    "freeAgentFanout": "All 100 free specialists contribute planning packets per turn",
    "squadSynthPhase": "10 squad leads (premium GPT-4o) synthesize per-squad readiness",
    "waveSize": 10,
    "minimumFreeReadinessPct": 100,
    "minimumSquadSynthPct": 80,
    "visibilityMode": "full-agent-activity"
  },
  "workflow": {
    "planning": {
      "model": "aegis-150-dual-threshold",
      "requiredEvidence": ["business-rules", "api-contract", "data-schema", "test-scenario"],
      "validationOrder": ["focused-diagnostics", "scope-level-checks", "workspace-checks"],
      "syncCadenceHours": 2
    },
    "development": {
      "deliveryStyle": "vertical-slice",
      "requiredChecks": ["typecheck", "lint", "build"],
      "targetedTestsRequired": true,
      "maxAutoFixRetries": 2
    },
    "git": {
      "defaultRemote": "origin",
      "integrationBranch": "develop",
      "integrationFallbackBranches": ["development", "main"],
      "releaseBranch": "main",
      "featureBranchPrefix": "feature/",
      "autoMergeReleaseBranch": false,
      "requirePullRequestForRelease": true
    }
  },
  "workflowGraph": {
    "enabled": true,
    "steps": ["plan", "code", "verify", "merge-ready"],
    "stepPatterns": {
      "sequential": ["plan", "code", "verify", "merge-ready"],
      "parallel": {
        "code": ["frontend", "backend", "tests"]
      },
      "handoff": {
        "plan→code": "@Ada→@Mira",
        "code→verify": "@Mira→@Katherine",
        "verify→merge-ready": "@Katherine→@Gwynne"
      },
      "group-review": {
        "trigger": "high-risk",
        "minRiskScore": 70,
        "reviewers": ["@Ada", "@Katherine", "@Radia"],
        "requiredApprovals": 2
      }
    },
    "stateDir": "logs/orchestrator/workflow-state"
  },
  "checkpoints": {
    "enabled": true,
    "saveOnStepTransition": true,
    "maxCheckpoints": 20,
    "checkpointDir": "logs/orchestrator/checkpoints",
    "autoCheckpointOnHardStop": true
  },
  "hardStops": {
    "stopOnTestFailure": true,
    "stopOnLintFailure": true,
    "stopOnBuildFailure": true,
    "stopOnPolicyMismatch": true,
    "stopOnSecurityScanFailure": true,
    "stopOnHighDiffRisk": true,
    "diffRiskScoreThreshold": 80,
    "flakyTestDetection": {
      "enabled": true,
      "failOnFlaky": false,
      "warnThreshold": 2
    }
  },
  "rollback": {
    "enabled": true,
    "maxRetriesBeforeRollback": 2,
    "autoRollbackOnMaxRetries": true,
    "fallbackOwner": "@Grace",
    "rollbackPlanDir": "logs/orchestrator/rollback-plans",
    "requireRollbackPlanBeforeExecution": true
  },
  "observability": {
    "tracing": {
      "enabled": true,
      "traceDir": "logs/orchestrator/traces",
      "format": "jsonl",
      "emitOnAgentTurn": true,
      "emitOnHandoff": true,
      "emitOnHardStop": true,
      "retainDays": 30
    },
    "budgetLimits": {
      "enabled": true,
      "maxEstimatedTokensPerSession": 500000,
      "maxRuntimeSeconds": 3600,
      "maxRetriesPerSession": 10,
      "hardCap": true,
      "budgetDir": "logs/orchestrator/budget"
    }
  },
  "benchmark": {
    "enabled": true,
    "cadence": "weekly",
    "metricsDir": "logs/orchestrator/benchmarks",
    "baselineFile": "logs/orchestrator/benchmarks/baseline.json",
    "metrics": [
      "taskSuccessRate",
      "passRate",
      "reworkRate",
      "cycleTimeSec",
      "rollbackRate"
    ],
    "regressionAlertThreshold": 0.1
  },
  "confidenceRouting": {
    "enabled": true,
    "autoApproveMinConfidence": 0.8,
    "requireHumanApprovalMaxConfidence": 0.5,
    "riskScoreLowMax": 30,
    "riskScoreHighMin": 70,
    "highRiskDomains": ["security", "auth", "payment", "database-migration"],
    "routingStateDir": "logs/orchestrator/confidence"
  }
}
