# White Caves CRM Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection string for Prisma
DATABASE_URL=mongodb://mongo:27017/white_caves

# Alternative: MongoDB Atlas (cloud)
# DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/white_caves?retryWrites=true&w=majority

# MongoDB direct connection (if not using Prisma)
MONGO_URI=mongodb://mongo:27017/white_caves
MONGO_USER=white_caves_admin
MONGO_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# ============================================================================
# REDIS CONFIGURATION (Caching & Message Queue)
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
REDIS_DB=0

# ============================================================================
# WHATSAPP INTEGRATION
# ============================================================================
WHATSAPP_SESSION_PATH=/app/data/whatsapp_sessions
WHATSAPP_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
WHATSAPP_HEADLESS=true
WHATSAPP_HEARTBEAT_INTERVAL=30000
WHATSAPP_RECONNECT_ATTEMPTS=5
WHATSAPP_RECONNECT_DELAY=5000

# ============================================================================
# FIREBASE CONFIGURATION (Optional: For authentication/storage)
# ============================================================================
FIREBASE_API_KEY=CHANGE_THIS
FIREBASE_AUTH_DOMAIN=CHANGE_THIS
FIREBASE_PROJECT_ID=CHANGE_THIS
FIREBASE_STORAGE_BUCKET=CHANGE_THIS
FIREBASE_MESSAGING_SENDER_ID=CHANGE_THIS
FIREBASE_APP_ID=CHANGE_THIS

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
SENTRY_DSN=https://your-key@sentry.io/project-id

# ============================================================================
# SECURITY
# ============================================================================
CORS_ORIGIN=https://white-caves.local
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
HELMET_CSP_ENABLED=true

# ============================================================================
# EMAIL CONFIGURATION (For notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_THIS
SMTP_PASSWORD=CHANGE_THIS_APP_PASSWORD
SMTP_FROM=noreply@white-caves.com
SMTP_TLS=true

# ============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================================================
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_REGION=us-east-1
DOCKER_REGISTRY=your-registry
DEPLOYMENT_VERSION=1.0.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_FIREBASE_AUTH=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_ANALYTICS=true
ENABLE_ERROR_TRACKING=true

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400
MAX_REQUEST_SIZE=10mb
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# ============================================================================
# CLEANUP & MAINTENANCE
# ============================================================================
CLEANUP_INTERVAL_HOURS=24
CLEANUP_OLD_SESSIONS_DAYS=30
CLEANUP_OLD_LOGS_DAYS=90
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
