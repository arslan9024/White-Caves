# White Caves CRM - Production Environment (Canonical)
# Copy to .env.production and replace all placeholder values.

# ============================================================================
# APP RUNTIME
# ============================================================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ============================================================================
# DATABASE (Canonical)
# ============================================================================
# REQUIRED: canonical Prisma/database connection string
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/white_caves?retryWrites=true&w=majority

# Legacy alias (optional, deprecated): only used if DATABASE_URL is missing
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/white_caves?retryWrites=true&w=majority

# ============================================================================
# SECURITY & CORE BACKEND (REQUIRED)
# ============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
CORS_ORIGIN=https://app.whitecaves.com
WHATSAPP_WEBHOOK_SECRET=CHANGE_THIS_TO_A_SECURE_WEBHOOK_SECRET

# ============================================================================
# FIREBASE CLIENT (VITE_ PREFIX REQUIRED FOR FRONTEND)
# ============================================================================
VITE_FIREBASE_API_KEY=CHANGE_THIS
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ============================================================================
# OPTIONAL INTEGRATIONS
# ============================================================================
# STRIPE_SECRET_KEY=sk_live_change_me
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# WHATSAPP_API_KEY=change_me

# Optional infrastructure
# REDIS_URL=redis://redis:6379
