{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "sourceMap": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/shared/*": [
        "./src/components/shared/*"
      ],
      "@/layouts/*": [
        "./src/layouts/*"
      ],
      "@/context/*": [
        "./src/context/*"
      ],
      "@/locales/*": [
        "./src/locales/*"
      ],
      "@/mocks/*": [
        "./src/mocks/*"
      ],
      "@/store/*": [
        "./src/store/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/server/*": [
        "./server/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "server/**",
    "src/**/*.backup.ts",
    "src/**/*.backup.tsx",
    "src/**/*.legacy.jsx",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/sidebars/examples/**",
    "src/components/sidebars/RelationalLeftSidebar/RelationalLeftSidebar.backup.tsx",
    "src/components/sidebars/RelationalRightSidebar/RelationalRightSidebar.backup.tsx",
    "src/**/*.legacy.jsx"
  ]
}
