  "governanceLaws": {
    "accelerationProtocol300": {
      "enabled": true,
      "targetPerformanceGainPct": 300,
      "cacheStrategy": "MapIndexHash",
      "maxQueryLatencyMs": 10,
      "serverRouteConsolidation": true,
      "zeroTokenPrecheckEnforced": true,
      "compression": "gzip/brotli",
      "lcpTargetMs": 1200,
      "zeroClsEnforced": true
    },
    "zeroBacklogLaw": {
      "enabled": true,
      "description": "Strict verification of 0 open sprint blockers and real-time synchronization",
      "catalogPath": "plans/AEGIS_200_PROJECT_AUDIT_UPGRADE_CATALOG.md",
      "autoEscalation": true
    },
    "singleMonolithSourceOfTruth": {
      "enabled": true,
      "description": "Permanent elimination of ghost mirror directories (business/, codebase/, scratch/); single repository truth",
      "canonicalRoot": "."
    },
    "canonicalFiveWayFileStandard": {
      "enabled": true,
      "categories": {
        "view": "*.view.tsx | *.tsx",
        "logic": "*.logic.ts",
        "styles": "*.styles.ts | *.css",
        "data": "*.data.ts",
        "config": "*.config.ts | *.json"
      },
      "maxFileLineLimit": 350,
      "singleResponsibilityEnforced": true
    },
    "continuousDeduplicationAndOptimization": {
      "enabled": true,
      "similarityThreshold": 0.85,
      "maxLoopComplexity": "O(n)",
      "autoPurgeUnreferencedExports": true,
      "autoCleanConsoleLogs": true,
      "memoization": true
    },
    "strictTokenPreservationShield": {
      "enabled": true,
      "version": "4.1",
      "hardTokenCeiling": 15000,
      "tokenRoiClassifier": {
        "CRITICAL_AI_CREDIT": "P0/P1 only, complex multi-file architectural changes",
        "FREE_TIER_SPECIALIST": "Planning, documentation, specs, research using Gemini 2.0 Flash / Llama 3.1 70B / DeepSeek V3",
        "ZERO_TOKEN_DETERMINISTIC": "Local AST resolutions, formatting, mock fixtures, zero LLM API calls"
      },
      "childSliceAntiExplosionFilter": true,
      "zeroTokenTrivialResolution": true,
      "contextWindowCompressor": true
    }
  },
  "readinessGates": {
    "readinessUnlockPct": 60,
    "readinessTargetPct": 90,
    "checksTotal": 20,
    "approvalPhrase": "@Ada — Context Ready (90% Readiness) — Coding Phase Approved",
    "depthGateLabel": "@Ada Reality Gate",
    "realityExecutionGate": {
      "enabled": true,
      "minSelectionScore": 120,
      "projectKeywords": [
        "homepage",
        "login",
        "auth",
        "api",
        "ux",
        "ui",
        "performance",
        "security",
        "dashboard",
        "crm",
        "property",
        "lead",
        "tenant",
        "automation"
      ],
      "qualityMarkers": [
        "implement",
        "verify",
        "validation",
        "rollback",
        "best-practice",
        "security",
        "test",
        "build",
        "lint",
        "typecheck"
      ]
    },
    "riskProfiles": {
      "security": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "audit"],
        "optionalChecks": ["test:e2e:accessibility"]
      },
      "auth": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "test:assistant-contract"],
        "optionalChecks": ["test:e2e:smoke"]
      },
      "database": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "build"],
        "optionalChecks": []
      },
      "payment": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "build"],
        "optionalChecks": ["audit"]
      },
      "general": {
        "requiredChecks": ["test:run"],
        "optionalChecks": []
      }
    }
  },
