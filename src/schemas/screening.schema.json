{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/screening.schema.json",
  "title": "ScreeningResult",
  "type": "object",
  "required": ["customerId", "provider", "timestamp"],
  "properties": {
    "customerId": { "type": "string" },
    "provider": { "type": "string", "description": "Screening provider name" },
    "timestamp": { "type": "string", "format": "date-time" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "listName": { "type": "string" },
          "matchedName": { "type": "string" },
          "matchScore": { "type": "number" },
          "matchType": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "rawResult": { "type": "object", "description": "Raw provider payload" },
    "resolvedBy": { "type": ["string", "null"] },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
