{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/kyc.schema.json",
  "title": "KYCProfile",
  "type": "object",
  "required": ["customerId", "legalName", "dob"],
  "properties": {
    "customerId": { "type": "string", "description": "Unique internal customer identifier" },
    "legalName": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "dob": { "type": "string", "format": "date" },
    "nationalities": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["residential", "postal", "business"] },
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "city": { "type": "string" },
          "region": { "type": "string" },
          "postalCode": { "type": "string" },
          "country": { "type": "string" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "idDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["passport", "id_card", "drivers_license"] },
          "country": { "type": "string" },
          "number": { "type": "string" },
          "issuedAt": { "type": "string", "format": "date" },
          "expiresAt": { "type": "string", "format": "date" },
          "imageUrl": { "type": "string", "format": "uri" }
        },
        "required": ["type", "country", "number"]
      }
    },
    "sourceOfFunds": { "type": "string" },
    "riskScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "notes": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
