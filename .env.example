# Firebase Configuration (Client-side - prefix with VITE_)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-side only - JSON string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Stripe Configuration (not yet integrated — future feature)
# VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# WhatsApp Configuration
VITE_WHATSAPP_NUMBER=971563616136
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret_here
WHATSAPP_BOT_TOKEN=your_whatsapp_bot_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# API Configuration
VITE_API_URL=/api
VITE_DOMAIN=localhost
VITE_APP_URL=http://localhost:5000

# Database (MongoDB via Prisma)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/whitecaves

# Auth & Security (REQUIRED in production — app crashes without these)
JWT_SECRET=change-this-to-a-secure-random-string
SESSION_SECRET=your_session_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS (REQUIRED in production — app crashes without this)
CORS_ORIGIN=http://localhost:5000

# Seed Script (optional — defaults to 'password123' in dev)
# SEED_PASSWORD=your-secure-seed-password

# Bank / Payment Details (Client-side — only expose what agents need to share)
# ⚠️  In production, serve via authenticated API: GET /api/payment/bank-details
VITE_BANK_NAME=Mashreq Bank
VITE_BANK_ACCOUNT_NAME=WHITE CAVES REAL ESTATE L.L.C
VITE_BANK_ACCOUNT_NUMBER=your_account_number
VITE_BANK_IBAN=your_iban

# ─── Email Service (Phase 5) ─────────────────────────────────────────────────
# Providers are auto-detected: set ONE of Resend, SendGrid, or SMTP.
# If none are set, mock provider is used (suitable for dev/staging).
# RESEND_API_KEY=re_your_resend_key
# SENDGRID_API_KEY=SG.your_sendgrid_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
EMAIL_FROM=noreply@whitecaves.ae
EMAIL_FROM_NAME=White Caves Real Estate

# ─── Meta Business API / WhatsApp (Nadia & Meta Webhooks) ────────────────────
# META_ACCESS_TOKEN=your_meta_access_token
# META_BUSINESS_ACCOUNT_ID=your_business_account_id
# META_PHONE_NUMBER_ID=your_phone_number_id
# META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ─── Linda WhatsApp LocalAuth ────────────────────────────────────────────────
# LINDA_SESSION_PATH=./.linda-session

# ─── Application Metadata ────────────────────────────────────────────────────
APP_VERSION=1.0.0
VITE_BANK_SWIFT=your_swift_code
VITE_BANK_ROUTING=your_routing_code
VITE_BANK_ACCOUNT_TYPE=Lite
VITE_BANK_BRANCH=Mashreq NEOBiz Digital

# Google APIs (Server-side only)
GOOGLE_API_KEY=your_google_api_key

# Monitoring (optional — leave empty to disable)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# PAGERDUTY_API_KEY=your_pagerduty_key
