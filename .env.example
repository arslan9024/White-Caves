# Firebase Configuration (Client-side - prefix with VITE_)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-side only) — choose ONE option:
# Option A: full service account JSON (single-line string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Option B: split variables
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe Configuration (not yet integrated — future feature)
# VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# WhatsApp Configuration
VITE_WHATSAPP_NUMBER=971505110636

# API Configuration
VITE_API_URL=/api
VITE_DOMAIN=localhost
VITE_APP_URL=http://localhost:5000

# Database (MongoDB via Prisma) — CANONICAL
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/whitecaves
# Legacy alias (optional, deprecated): only used if DATABASE_URL is missing
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/whitecaves

# Auth & Security (REQUIRED in production — app crashes without these)
JWT_SECRET=change-this-to-a-secure-random-string
SESSION_SECRET=your_session_secret_here

# Creator / Superuser email — stored here, NOT hardcoded in source (OWASP A01)
# Set to the email address that should receive elevated system-owner privileges.
# Leave empty in CI/test environments unless required.
CREATOR_SUPERUSER_EMAIL=
VITE_CREATOR_SUPERUSER_EMAIL=

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS (REQUIRED in production — app crashes without this)
CORS_ORIGIN=http://localhost:5000

# Webhooks (REQUIRED in production — app crashes without this)
WHATSAPP_WEBHOOK_SECRET=change-this-to-a-secure-webhook-secret

# Seed Script (optional — defaults to 'password123' in dev)
# SEED_PASSWORD=your-secure-seed-password

# Bank / Payment Details (Client-side — only expose what agents need to share)
# ⚠️  In production, serve via authenticated API: GET /api/payment/bank-details
VITE_BANK_NAME=Mashreq Bank
VITE_BANK_ACCOUNT_NAME=WHITE CAVES REAL ESTATE L.L.C
VITE_BANK_ACCOUNT_NUMBER=your_account_number
VITE_BANK_IBAN=your_iban
VITE_BANK_SWIFT=your_swift_code
VITE_BANK_ROUTING=your_routing_code
VITE_BANK_ACCOUNT_TYPE=Lite
VITE_BANK_BRANCH=Mashreq NEOBiz Digital

# Google APIs (Server-side only)
GOOGLE_API_KEY=your_google_api_key

# Linda LocalAuth WhatsApp Bot
# Set LINDA_ENABLED=false to disable the Linda channel entirely
LINDA_ENABLED=true
LINDA_SESSIONS_PATH=./.linda-sessions
LINDA_BOT_MASTER_NUMBER=971505760056
LINDA_HEADLESS=true
LINDA_RECONNECT_DELAY=5000
LINDA_MAX_RECONNECT_ATTEMPTS=999
# Google Sheets integration (optional — leave empty to disable)
LINDA_GOOGLE_SHEET_ID=
LINDA_GOOGLE_KEYS_BASE64=

# Henry Document Hub
# Path where archived PDFs are stored (relative to project root)
HENRY_UPLOADS_PATH=./uploads/henry
# Groq API key for server-side AI field extraction (optional — used by /api/henry/ai/extract)
GROQ_API_KEY=
# Ollama base URL for local LLM inference (optional — defaults to localhost)
OLLAMA_HOST=http://localhost:11434

# Monitoring (optional — leave empty to disable)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# PAGERDUTY_API_KEY=your_pagerduty_key
