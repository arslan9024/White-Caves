
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ────────────────────────────────────────────────────────

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String?
  photoUrl     String?
  role         String   @default("agent") // owner, agent, viewer
  phone        String?
  department   String?
  status       String   @default("active")
  passwordHash String?  // bcrypt hash — null means password not set yet
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?  // Encrypted TOTP secret (base32 payload)
  firebaseUid  String?  // Firebase UID for social/phone auth sync (optional, indexed but not unique)
  brnNumber    String?  // RERA Broker Registration Number
  brnExpiry    DateTime? // BRN expiry date
  reraLicenseNumber String? // RERA Brokerage License Number
  // ── TOTP two-factor authentication (RFC 6238) ──
  totpSecret      String?   // base32-encoded shared secret (encrypted at application layer)
  totpEnabled     Boolean   @default(false) // true = TOTP is active for this account
  totpBackupCodes String[]  // one-time recovery codes (bcrypt-hashed)
  refreshTokenHash  String?   // bcrypt hash of active refresh token; null = no active session
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties    Property[]
  leadsAssigned Lead[]       @relation("AssignedAgent")
  leadsCreated  Lead[]       @relation("CreatedBy")
  activities    Activity[]
  transactions  Transaction[] @relation("TransactionAgent")
  commissions   Commission[]
  favorites     Favorite[]
  savedSearches SavedSearch[]
  viewings      Viewing[]    @relation("ViewingUser")
  assignedViewings Viewing[] @relation("ViewingAgent")
  agentAvailability AgentAvailability[]
  offersAsBuyer Offer[]      @relation("OfferBuyer")
  leasesAsTenant Lease[]     @relation("LeaseTenant")
  leasesAsLandlord Lease[]   @relation("LeaseLandlord")
  maintenanceRequests Maintenance[] @relation("MaintenanceRequester")
  pdcCheques    PDCSchedule[] @relation("PDCTenant")
  valuationsCreated  PropertyValuation[] @relation("ValuationCreator")
  valuationsOverridden PropertyValuation[] @relation("ValuationOverrider")

  @@index([role])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([firebaseUid])
}

// ─── PROPERTY ───────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        String   @default("apartment") // villa, apartment, penthouse, commercial, land, townhouse
  status      String   @default("available")  // available, reserved, sold, rented, off_market
  price       Float
  currency    String   @default("AED")  // AED, USD, EUR, GBP, INR
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  sqft        Int      @default(0)
  location    String
  area        String?
  amenities   String[]
  images      String[]
  featured    Boolean  @default(false)
  agentName   String?

  // ─── @Mary Intelligent Inventory Fields ──────────────────────────────
  unitNumber        String?              // e.g. "A-1204"
  floorPlan         String?              // e.g. "2BR-TypeA"
  rentalPrice       Float?               // Annual rental price in AED
  commissionPercent Float?  @default(5) // Agent commission %
  availabilityDate  DateTime?            // Date property is available to lease
  inventoryStage    String  @default("draft_collected")
  // Inventory stages: draft_collected | verified_active | under_offer | leased_sold | handed_over
  isLocked          Boolean @default(false) // Locked when an offer is approved
  lockedAt          DateTime?            // Timestamp when locked

  // Document flags — flagged when missing
  titleDeedMissing         Boolean @default(false)
  landlordPassportMissing  Boolean @default(false)
  ejariMissing             Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // RERA / Dubai DLD compliance fields
  municipalityNumber  String? // Dubai municipality plot/unit number
  plotNumber          String? // DLD plot number
  buildingPermitNumber String? // Building permit from Dubai Municipality
  rentIndexRef        String? // RERA Rent Index reference (for rent increase calculations)
  furnished           Boolean @default(false) // affects max deposit calculation

  // Verification evidence fields (P0-012)
  verifiedAt        DateTime?  // when listing was verified
  verifiedBy        String?    @db.ObjectId  // userId who verified
  verificationNotes String?    // evidence notes
  lastRefreshedAt   DateTime?  // when agent last confirmed details are current

  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  leads       Lead[]
  transactions Transaction[]
  tenants      Tenant[]
  commissions  Commission[]
  favorites    Favorite[]
  viewings     Viewing[]
  offers       Offer[]
  leases       Lease[]
  maintenanceRequests Maintenance[]
  valuations   PropertyValuation[] @relation("PropertyValuations")

  @@index([status])
  @@index([type])
  @@index([featured])
  @@index([createdAt])
  @@index([price])
  @@index([userId])
  @@index([area])
  @@index([inventoryStage])
  @@index([isLocked])
  @@index([availabilityDate])
}

// ─── LEAD ───────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("new") // new, contacted, qualified, hot, warm, cold, won, lost
  source      String   @default("direct") // whatsapp, website, phone, referral, marketing, direct
  budget      Float?
  budgetCurrency String @default("AED")  // AED, USD, EUR, GBP, INR
  score       Int      @default(0) // 0-100 lead score
  scoreBreakdown Json?  // { engagement, demographic, behavioral, source, lastScoredAt }
  scoreTier   String   @default("cold") // hot (80+), warm (60-79), cold (<60), inactive
  lastScoredAt DateTime?
  notes       String?
  tags        String[]
  lastContact DateTime?
  // Leasing-specific fields
  dealType    String   @default("lease") // lease, sale, buy
  leasingStage Int     @default(1) // 1=Lead Acquisition, 2=Matching, 3=Viewing, 4=Offer, 5=Decision, 6=Deposit, 7=Contract, 8=Handover, 9=Payment, 10=PnL
  tenantRequirements Json? // { bedrooms, furnishing, maxRent, preferredArea, petPolicy, smokingPolicy, parking, community, moveInDate }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignedToId String?  @db.ObjectId
  assignedTo   User?    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  createdById  String?  @db.ObjectId
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id])
  propertyId   String?  @db.ObjectId
  property     Property? @relation(fields: [propertyId], references: [id])
  activities   Activity[]
  transactions Transaction[]
  commissions  Commission[]
  viewings     Viewing[]
  offers       Offer[]
  followUpSequences FollowUpSequence[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([createdById])
  @@index([createdAt])
  @@index([score])
  @@index([propertyId])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([assignedToId, status])
  @@index([status, source, createdAt])
  @@index([dealType])
  @@index([leasingStage])
}

// ─── LEAD SCORE HISTORY ─────────────────────────────────────────────────

model LeadScoreHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId      String   @db.ObjectId
  score       Int      // 0-100
  tier        String   // hot, warm, cold, inactive
  previousScore Int    // Previous score for delta tracking
  previousTier  String // Previous tier for transition tracking
  breakdown   Json?    // { engagement, demographic, behavioral, source }
  trigger     String   // middleware, batch, manual, override, whatsapp
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@index([leadId, createdAt])
}

// ─── ACTIVITY ───────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // lead, property, deal, commission, agent, client, system
  action      String   // created, updated, deleted, status_changed, note_added, call, email, visit
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])

  @@index([type])
  @@index([action])
  @@index([type, action])  // Composite for filtered queries
  @@index([userId])
  @@index([leadId])
  @@index([createdAt])
}

// ─── TRANSACTION ────────────────────────────────────────────────────────

model Transaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   @default("sale")  // sale, rental, lease
  status        String   @default("draft") // draft, pending, in_progress, completed, cancelled
  amount        Float
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  closingDate   DateTime?
  notes         String?
  documents     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?     @relation(fields: [leadId], references: [id])
  agentId       String?  @db.ObjectId
  agent         User?     @relation("TransactionAgent", fields: [agentId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([propertyId])
  @@index([agentId])
  @@index([leadId])
}

// ─── TENANT ─────────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String?
  phone         String?
  nationality   String?
  emiratesId    String?
  status        String   @default("active") // active, inactive, pending
  moveInDate    DateTime?
  moveOutDate   DateTime?
  monthlyRent   Float?
  deposit       Float?
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])

  @@index([status])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── NADIA: WHATSAPP WEBHOOK & ROUTING ──────────────────────────────────────

model NadiaConversation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  wabaId      String   // Meta WABA ID
  customerPhone String  // Customer's WhatsApp number
  agentPhone  String?  // Assigned agent phone (if assigned)
  
  // Message history
  messages    NadiaMessage[]
  queue       NadiaConversationQueue?
  
  // NLP & Routing
  intent      String?  // From Nina: property_search, schedule_tour, etc.
  leadScore   Int      @default(0) // 0-100 from Nina
  timeline    String?  // From Nina: ASAP, 1-3mo, etc.
  
  // Status
  status      String   @default("active") // active, assigned_to_agent, in_bot_flow, closed
  routedAt    DateTime?
  closedAt    DateTime?
  closedReason String?  // why conversation closed

  // P0-017: CRM lead linkage (unique: one lead per conversation)
  leadId           String?   @db.ObjectId @unique
  convertedAt      DateTime? // when convert-to-lead was triggered
  convertedByPhone String?   // agent phone who triggered conversion

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([customerPhone])
  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
  @@index([agentPhone])
}

model NadiaMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String @db.ObjectId
  conversation NadiaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  waMessageId String   // Message ID from Meta WhatsApp
  direction   String   // inbound | outbound
  body        String
  messageType String   @default("text") // text, image, document, audio, video
  
  status      String   @default("sent") // sent, delivered, read, failed
  
  timestamp   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([conversationId])
  @@index([status])
  @@index([timestamp])
}

model NadiaConversationQueue {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @unique @db.ObjectId
  conversation    NadiaConversation @relation(fields: [conversationId], references: [id])
  
  priority        Int      // 1-10, higher = better
  status          String   @default("waiting") // waiting, assigned, completed
  assignedTo      String?  // Agent phone if assigned
  assignedAt      DateTime?
  queuedAt        DateTime @default(now())
  completedAt     DateTime?
  
  // SLA tracking
  responseTime    Int?     // milliseconds
  
  @@index([status])
  @@index([priority])
  @@index([queuedAt])
}

// ─── COMMISSION ─────────────────────────────────────────────────────────

model Commission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  amount      Float
  currency    String   @default("AED")  // AED, USD, EUR, GBP, INR
  percentage  Float?   // Commission percentage (0-100), optional
  type        String   @default("sale")      // sale, rental, referral
  status      String   @default("pending")   // pending, approved, paid, cancelled
  notes       String?
  paidAt      DateTime?
  vatRate     Float?   @default(5)  // VAT percentage: 0% residential, 5% commercial, 5% on commission
  vatAmount   Float?   @default(0)  // Calculated VAT amount
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agentId     String   @db.ObjectId
  agent       User     @relation(fields: [agentId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])
  propertyId  String?  @db.ObjectId
  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([agentId, status])  // Composite for agent performance queries
  @@index([propertyId])
  @@index([leadId])
}

// ─── FAVORITE ───────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())

  // Relations
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId]) // One favorite per user per property
  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── SAVED SEARCH ───────────────────────────────────────────────────────

model SavedSearch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // e.g. "3BR apartments in JBR under 2M"
  filters     Json     // { type, minPrice, maxPrice, bedrooms, location, area, ... }
  alertEnabled Boolean @default(false) // Notify user when new matches appear
  lastChecked DateTime?
  matchCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([alertEnabled])
  @@index([createdAt])
}

// ─── VIEWING ────────────────────────────────────────────────────────────

model Viewing {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  scheduledAt   DateTime
  duration      Int       @default(30)  // minutes
  status        String    @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show
  type          String    @default("in_person") // in_person, virtual, open_house
  notes         String?
  feedback      String?   // Post-viewing feedback
  rating        Int?      // 1-5 star rating
  location      String?   // Meeting point or virtual link
  reminderSent  Boolean   @default(false)  // Whether reminder notification was sent
  confirmedAt   DateTime? // When the viewing was confirmed
  cancelReason  String?   // Reason for cancellation
  icsToken      String?   // Unique token for .ics calendar download
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId        String   @db.ObjectId
  user          User     @relation("ViewingUser", fields: [userId], references: [id])
  agentId       String?  @db.ObjectId
  agent         User?    @relation("ViewingAgent", fields: [agentId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?    @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([agentId])
  @@index([propertyId])
  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// ─── AGENT AVAILABILITY ─────────────────────────────────────────────────

model AgentAvailability {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek     Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime     String   // HH:mm format (e.g. "09:00")
  endTime       String   // HH:mm format (e.g. "18:00")
  isActive      Boolean  @default(true)
  slotDuration  Int      @default(30)  // minutes per slot
  breakStart    String?  // Break start time HH:mm (e.g. "12:00")
  breakEnd      String?  // Break end time HH:mm (e.g. "13:00")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  agentId       String   @db.ObjectId
  agent         User     @relation(fields: [agentId], references: [id])

  @@unique([agentId, dayOfWeek])
  @@index([agentId])
  @@index([dayOfWeek])
}

// ─── OFFER ──────────────────────────────────────────────────────────────

model Offer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  status        String   @default("pending") // pending, accepted, rejected, countered, expired, withdrawn
  offerType     String   @default("lease") // lease, sale
  expiresAt     DateTime?
  terms         String?  // Free-text negotiation terms
  counterAmount Float?   // Counter-offer amount
  counterHistory Json?   // Array of { amount, terms, by, at } for multi-round negotiation
  notes         String?
  rejectionReason String? // Reason when status = rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  buyerId       String   @db.ObjectId
  buyer         User     @relation("OfferBuyer", fields: [buyerId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?    @relation(fields: [leadId], references: [id])

  @@index([buyerId])
  @@index([propertyId])
  @@index([leadId])
  @@index([status])
  @@index([offerType])
  @@index([createdAt])
}

// ─── LEASE ──────────────────────────────────────────────────────────────

model Lease {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  leaseNumber   String?
  startDate     DateTime
  endDate       DateTime
  monthlyRent   Float
  depositAmount Float    @default(0)
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  status        String   @default("draft") // draft, active, expiring, expired, terminated, renewed
  terms         String?
  documents     String[]
  nextPaymentDue DateTime?
  ejariNumber   String?   // Ejari registration number
  ejariStatus   String?   @default("pending") // pending, registered, expired, cancelled
  ejariRegistrationDate DateTime? // When Ejari was registered
  ejariExpiryDate DateTime? // When Ejari registration expires
  // Key handover fields
  keyHandoverDate DateTime? // Date keys were handed over to tenant
  keyHandoverNotes String?  // Notes from handover inspection
  meterReadings Json?       // { dewa: "...", gas: "...", accessCards: "...", parkingSticker: "..." }
  addendumDocuments String[] // URLs of addendum PDFs attached to this lease
  // Linked offer that created this lease (for P&L traceability)
  offerId       String?   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenantId      String   @db.ObjectId
  tenant        User     @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId    String   @db.ObjectId
  landlord      User     @relation("LeaseLandlord", fields: [landlordId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])
  addenda       LeaseAddendum[]
  pdcSchedule   PDCSchedule[]

  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
  @@index([endDate])
  @@index([createdAt])
}

// ─── MAINTENANCE ────────────────────────────────────────────────────────

model Maintenance {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  category      String   @default("general") // plumbing, electrical, hvac, appliance, structural, general
  priority      String   @default("medium")  // low, medium, high, emergency
  status        String   @default("open")    // open, in_progress, scheduled, completed, cancelled
  scheduledDate DateTime?
  completedAt   DateTime?
  cost          Float?
  costCurrency  String   @default("AED")  // AED, USD, EUR, GBP, INR
  images        String[]
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  requesterId   String   @db.ObjectId
  requester     User     @relation("MaintenanceRequester", fields: [requesterId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])

  @@index([requesterId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

// ─── JOB APPLICATION ────────────────────────────────────────────────────

model JobApplication {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  phone         String?
  position      String
  experience    String?
  resumeUrl     String?
  coverLetter   String?
  status        String   @default("received") // received, reviewed, shortlisted, interview, offered, hired, rejected
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([position])
  @@index([email])
  @@index([createdAt])
}

// ─── INVOICE ────────────────────────────────────────────────────────────

// ─── CLIENT ─────────────────────────────────────────────────────────────

model Client {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String?
  phone               String?
  company             String?
  category            String   @default("buyer")      // buyer, seller, landlord, tenant, investor
  status              String   @default("active")      // active, inactive, prospect, archived
  type                String   @default("individual")  // individual, corporate, investment_firm
  nationality         String?
  totalValue          Float    @default(0)             // total deal value
  totalValueCurrency  String   @default("AED")          // AED, USD, EUR, GBP, INR
  dealsCount          Int      @default(0)
  notes               String?
  tags                String[]
  lastContact         DateTime?
  convertedFromLeadId String?  @db.ObjectId            // if converted from a Lead
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations (agent ref stored as plain ID — no FK constraint)
  assignedToId        String?  @db.ObjectId
  communications      Communication[]
  clientProperties    ClientProperty[]

  @@index([category])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([email])
  @@index([createdAt])
}

// ─── CLIENT ↔ PROPERTY JUNCTION ─────────────────────────────────────────

model ClientProperty {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String   @db.ObjectId
  client          Client   @relation(fields: [clientId], references: [id])
  propertyId      String   @db.ObjectId          // plain ref — avoids modifying Property model
  relationship    String   @default("interested") // owner, tenant, buyer, interested, previous_owner, previous_tenant
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([clientId, propertyId])
  @@index([clientId])
  @@index([propertyId])
  @@index([relationship])
}

// ─── COMMUNICATION LOG ──────────────────────────────────────────────────

model Communication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id])
  type        String   @default("note")      // call, email, whatsapp, meeting, note, sms
  direction   String   @default("outbound")  // inbound, outbound
  subject     String?
  body        String?
  duration    Int?                            // seconds (for calls/meetings)
  outcome     String?                         // interested, follow_up, not_available, closed, no_answer
  createdAt   DateTime @default(now())

  // Who logged it (plain ID — no FK constraint)
  createdById String?  @db.ObjectId

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
}

// ─── INVOICE ────────────────────────────────────────────────────────────

model Invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String   @unique           // "INV-2026-0001"
  client        String                     // Client name
  property      String?                    // Property reference
  amount        Float
  vatAmount     Float    @default(0)       // 5% VAT for commercial
  totalAmount   Float                      // amount + vatAmount
  currency      String   @default("AED")
  status        String   @default("draft") // draft, pending, paid, overdue, cancelled, refunded
  date          DateTime @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?
  lineItems     Json?                      // [{ description, qty, unitPrice, total }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdById   String?  @db.ObjectId

  @@index([status])
  @@index([client])
  @@index([dueDate])
  @@index([createdAt])
}

// ─── EXPENSE ────────────────────────────────────────────────────────────

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String                     // Marketing, Maintenance, Utilities, Salaries, Office, Legal, Insurance
  description   String
  amount        Float
  currency      String   @default("AED")
  status        String   @default("pending") // pending, approved, rejected, processed, reimbursed
  date          DateTime @default(now())
  receiptUrl    String?                    // Receipt/document upload
  notes         String?
  approvedById  String?  @db.ObjectId
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdById   String?  @db.ObjectId

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([createdAt])
  @@index([approvedById])
}

// ─── FOLLOW-UP SEQUENCE ─────────────────────────────────────────────────

model FollowUpSequence {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cadenceType   String   // hot, warm, cold, custom
  status        String   @default("active") // active, paused, completed, cancelled
  currentStep   Int      @default(0)
  totalSteps    Int      @default(4)
  startedAt     DateTime @default(now())
  pausedAt      DateTime?
  completedAt   DateTime?
  nextStepAt    DateTime? // when the next step should fire
  metadata      Json?    // custom overrides, notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  leadId        String   @db.ObjectId
  lead          Lead     @relation(fields: [leadId], references: [id])
  createdById   String?  @db.ObjectId
  steps         FollowUpStep[]

  @@index([status])
  @@index([cadenceType])
  @@index([leadId])
  @@index([nextStepAt])
  @@index([status, nextStepAt])
}

model FollowUpStep {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  stepNumber    Int      // 1, 2, 3, 4...
  channel       String   // whatsapp, email, call, sms
  status        String   @default("pending") // pending, scheduled, sent, delivered, failed, skipped
  scheduledAt   DateTime?
  executedAt    DateTime?
  templateName  String?  // e.g. "follow_up_viewing", "initial_contact"
  message       String?  // actual message content (if custom)
  result        String?  // response outcome: replied, no_response, bounced, call_answered, call_no_answer
  errorMessage  String?  // if failed
  metadata      Json?    // messageId, deliveryStatus, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sequenceId    String   @db.ObjectId
  sequence      FollowUpSequence @relation(fields: [sequenceId], references: [id])

  @@index([sequenceId])
  @@index([status])
  @@index([stepNumber])
  @@index([scheduledAt])
  @@index([channel])
}

// ─── WEBAUTHN CREDENTIAL ────────────────────────────────────────────────

model WebAuthnCredential {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  credentialId    String   @unique      // base64url-encoded credential ID
  publicKey       String               // base64url-encoded public key (COSE format)
  counter         Int      @default(0) // signature counter for replay protection
  deviceType      String?              // "platform" | "cross-platform"
  transports      String[]             // ["internal", "usb", ...]
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

// ─── DOCUMENT ───────────────────────────────────────────────────────────

model Document {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   // mou, form_f, noc, commission_invoice, viewing_report, offer_letter
  title         String
  version       Int      @default(1)
  status        String   @default("draft") // draft, final, signed, archived
  htmlContent   String   // rendered HTML content
  metadata      Json?    // template variables, generation context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Related entities (optional — a document may link to any combination)
  transactionId String?  @db.ObjectId
  leadId        String?  @db.ObjectId
  propertyId    String?  @db.ObjectId
  commissionId  String?  @db.ObjectId
  generatedById String?  @db.ObjectId

  @@index([type])
  @@index([status])
  @@index([transactionId])
  @@index([leadId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── CONTRACT ───────────────────────────────────────────────────────────

model Contract {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  contractNumber   String   @unique            // "WC-C-2026-0001"
  type             String   @default("sale")   // sale, rental, mou, form_f, listing, management
  status           String   @default("draft")  // draft, pending_signature, active, expired, terminated, cancelled
  title            String
  description      String?
  value            Float?                       // contract value (AED)
  currency         String   @default("AED")
  startDate        DateTime?
  endDate          DateTime?
  signedAt         DateTime?
  terminatedAt     DateTime?
  terminationReason String?
  parties          Json?                        // [{ role, name, email, phone }]
  terms            String?                      // free-text contract terms / notes
  attachmentUrls   String[]                     // uploaded document URLs
  metadata         Json?                        // extra key/value pairs

  // Relations
  propertyId       String?  @db.ObjectId
  leadId           String?  @db.ObjectId
  transactionId    String?  @db.ObjectId
  createdById      String?  @db.ObjectId
  assignedToId     String?  @db.ObjectId

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([propertyId])
  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

// ─── APPOINTMENT ────────────────────────────────────────────────────────

model Appointment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  type           String   @default("viewing")  // viewing, meeting, call, inspection, signing
  status         String   @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show
  scheduledAt    DateTime
  durationMins   Int      @default(60)
  location       String?
  notes          String?
  cancelReason   String?
  reminderSentAt DateTime?
  completedAt    DateTime?

  // Participants
  clientName     String?
  clientEmail    String?
  clientPhone    String?
  agentId        String?  @db.ObjectId
  propertyId     String?  @db.ObjectId
  leadId         String?  @db.ObjectId
  createdById    String?  @db.ObjectId

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([agentId])
  @@index([propertyId])
  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

// ─── ROLE REQUEST ───────────────────────────────────────────────────────

model RoleRequest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  requestedRole  String                         // role being requested
  currentRole    String                         // user's current role at time of request
  reason         String?                        // why they need this role
  status         String   @default("pending")   // pending, approved, rejected
  reviewNote     String?                        // admin notes on decision
  reviewedById   String?  @db.ObjectId
  reviewedAt     DateTime?

  userId         String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestedRole])
  @@index([createdAt])
}

// ─── SYSTEM SETTINGS ────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique              // unique setting key, e.g. "company_name"
  value     Json                          // any JSON-serialisable value
  category  String   @default("general") // general, notifications, branding, compliance, etc.
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId        // userId who last updated

  @@index([category])
}

// ─── LEASE ADDENDUM ─────────────────────────────────────────────────────

model LeaseAddendum {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  clause        String   // Full text of the addendum clause
  agreedBy      String[] // List of party identifiers who agreed (e.g. tenantId, landlordId)
  signedAt      DateTime?
  documentUrl   String?  // URL of the signed addendum PDF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  leaseId       String   @db.ObjectId
  lease         Lease    @relation(fields: [leaseId], references: [id])

  @@index([leaseId])
  @@index([createdAt])
}

// ─── PDC SCHEDULE ───────────────────────────────────────────────────────

model PDCSchedule {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  chequeNumber  String
  bankName      String
  amount        Float
  currency      String   @default("AED")
  dueDate       DateTime
  status        String   @default("pending") // pending, presented, cleared, bounced
  chequeImageUrl String? // Upload of scanned cheque
  reminderSent  Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  leaseId       String   @db.ObjectId
  lease         Lease    @relation(fields: [leaseId], references: [id])
  tenantId      String   @db.ObjectId
  tenant        User     @relation("PDCTenant", fields: [tenantId], references: [id])

  @@index([leaseId])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

// ─── LINDA: BOT SESSION ─────────────────────────────────────────────────

model LindaSession {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  botId       String   @unique               // e.g. "linda-primary", "linda-backup"
  phoneNumber String?                         // Phone number registered to this bot
  role        String   @default("primary")   // primary, backup, campaign
  sessionPath String?                         // Filesystem path to LocalAuth session folder
  status      String   @default("disconnected") // disconnected, authenticating, ready, error
  lastSeen    DateTime?
  qrCodeAt    DateTime?                       // When last QR was generated
  metadata    Json?                           // Puppeteer options, bot config overrides
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

// ─── LINDA: BROADCAST CAMPAIGN ──────────────────────────────────────────

model LindaBroadcastCampaign {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  targetList      String[] // Phone numbers (E.164 without +)
  messageTemplate String                       // Message body with {{variable}} placeholders
  templateVars    Json?                        // Variable substitution map
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  status          String   @default("draft") // draft, scheduled, running, completed, failed, cancelled
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  results         Json?   // Array of { phone, messageId, error? }
  channel         String   @default("LINDA_WHATSAPP")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations (optional — campaigns may or may not be linked to a specific bot)
  createdById     String?  @db.ObjectId

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([createdById])
}

// ─── LINDA: COMMISSION RULE ─────────────────────────────────────────────

model CommissionRule {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  type            String   @default("percentage") // percentage, fixed, tiered
  rate            Float                           // Percentage (e.g. 2.0 for 2%) or fixed AED amount
  tiers           Json?    // For tiered: [{ min, max, rate }]
  applicableTo    String[] // deal types: sale, lease, off_plan, secondary
  conditions      Json?    // Extra conditions: { minDealValue, maxDealValue, areaFilter }
  approvalStatus  String   @default("active")    // active, inactive, pending_approval
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdById     String?  @db.ObjectId
  records         CommissionRecord[]

  @@index([approvalStatus])
  @@index([type])
  @@index([effectiveFrom])
  @@index([createdAt])
}

// ─── LINDA: COMMISSION RECORD ───────────────────────────────────────────

model CommissionRecord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  agentId         String   @db.ObjectId        // The agent earning the commission
  dealValue       Float                         // Deal value in AED
  commissionAmount Float                        // Calculated commission AED
  vatAmount       Float    @default(0)          // 5% VAT if applicable
  netAmount       Float                         // commissionAmount + vatAmount
  currency        String   @default("AED")
  status          String   @default("pending") // pending, approved, invoiced, paid, disputed
  payoutDate      DateTime?
  invoiceNumber   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  ruleId          String   @db.ObjectId
  rule            CommissionRule @relation(fields: [ruleId], references: [id])
  offerId         String?  @db.ObjectId        // The deal that generated this commission
  approvedById    String?  @db.ObjectId

  @@index([agentId])
  @@index([status])
  @@index([ruleId])
  @@index([payoutDate])
  @@index([createdAt])
}

// ─── COMMUNICATION TEMPLATE ─────────────────────────────────────────────

model CommunicationTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  category    String   @default("general") // general, lease_reminder, payment_due, maintenance, campaign, welcome
  channel     String   @default("whatsapp") // whatsapp, email, sms, push
  subject     String?  // For email templates
  body        String   // Template body with {{variable}} placeholders
  variables   String[] // List of variable names used in body
  isActive    Boolean  @default(true)
  language    String   @default("en") // en, ar
  metaApproved Boolean @default(false) // For WhatsApp — whether Meta has approved this template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?  @db.ObjectId

  @@index([category])
  @@index([channel])
  @@index([isActive])
  @@index([createdAt])
}

// ─── NOTIFICATION SCHEDULE ──────────────────────────────────────────────

model NotificationSchedule {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  type            String                         // contract_expiry, payment_reminder, maintenance_sla, lease_renewal, pdc_due
  entityType      String                         // lease, pdc, maintenance, contract
  entityId        String   @db.ObjectId
  scheduledAt     DateTime
  status          String   @default("pending")  // pending, sent, failed, cancelled, skipped
  sentAt          DateTime?
  channel         String   @default("whatsapp") // whatsapp, email, sms, push
  recipientId     String   @db.ObjectId         // User to notify
  escalationChain String[] // Ordered list of User IDs to escalate to if primary recipient ignores
  escalatedAt     DateTime?
  message         String?                        // Rendered message (filled at send time)
  errorMessage    String?
  metadata        Json?    // Template variables, context
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdById     String?  @db.ObjectId

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([entityType])
  @@index([recipientId])
  @@index([createdAt])
}

// ─── NOTIFICATION ──────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  type        String   @default("info")     // info, success, warning, error, lead, property, commission, system
  channel     String   @default("in_app")   // in_app, email, whatsapp
  title       String
  message     String
  metadata    Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
  @@index([channel])
}

// ─── HENRY: DOCUMENT RECORD ─────────────────────────────────────────────

model HenryRecord {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  templateKey      String                         // tenancy_contract, booking_form, addendum, etc.
  templateLabel    String                         // Human-readable template name
  fileName         String                         // Original file name
  recordPath       String                         // Relative path under uploads/henry/
  departmentTag    String?                        // sales, leasing, finance, compliance, legal, operations
  ownerUserId      String?  @db.ObjectId          // User primarily responsible for this record
  ownerUserEmail   String?                        // Denormalized owner email for filtering/inspection
  unit             String?                        // Unit number / apartment
  community        String?                        // Community / building name
  tenantName       String?                        // For quick display without parsing JSON
  isDraft          Boolean  @default(false)
  status           String   @default("draft")     // draft, pending_signature, signed, archived
  signedAt         DateTime?                      // When all required signatures were completed
  archivedAt       DateTime?                      // When moved to archived state
  copyNumber       Int      @default(1)
  documentSnapshot Json                           // Flat key-value snapshot of document fields at time of archive
                                                   // e.g. {landlordName, tenantName, annualRent, leaseStartDate, ...}
  createdBy        String   @db.ObjectId          // User who generated/archived
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([templateKey])
  @@index([community])
  @@index([tenantName])
  @@index([departmentTag])
  @@index([ownerUserId])
  @@index([ownerUserEmail])
  @@index([status])
  @@index([signedAt])
  @@index([isDraft])
  @@index([createdBy])
  @@index([createdAt])
}

// ===== RECRUITMENT MODELS (Phase 1C Part 3) =====

model Job {
  id                  String   @id @default(uuid()) @map("_id")
  title               String
  description         String?
  department          String?
  location            String?
  salary_min          Float?
  salary_max          Float?
  required_skills     String[]
  experience_years    Int?
  status              String   @default("open") // open, closed, on_hold
  source              String?  // linkedin, internal, job_board
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  applications        Application[]
  interviews          Interview[]
  candidateScores     CandidateScore[]
  leadScores          LeadScore[]
  conversationMetrics ConversationMetric[]
  interviewSchedules  InterviewSchedule[]
}

model Candidate {
  id                  String   @id @default(uuid()) @map("_id")
  email               String   @unique
  phone               String?
  first_name          String?
  last_name           String?
  location            String?
  linkedin_url        String?
  resume_url          String?
  resume_text         String?
  source              String?  // linkedin, indeed, manual_upload, etc.
  status              String   @default("new") // new, under_review, rejected, selected, hired
  notes               String?
  
  // Phase 1C Part 3 Fields
  conversation_score  Float    @default(0) // 0-100
  lead_temperature    String   @default("WARM") // HOT, WARM, COLD
  engagement_score    Float    @default(0) // 0-100
  last_analyzed_at    DateTime?
  whatsapp_phone      String?  // For WhatsApp tracking
  opt_in_messaging    Boolean  @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  applications        Application[]
  scores              CandidateScore[]
  interviews          Interview[]
  leadScores          LeadScore[]
  conversationMetrics ConversationMetric[]
  interviewSchedules  InterviewSchedule[]
}

model Application {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String
  status              String   @default("applied") // applied, screening, interview, offer, hired, rejected
  applied_at          DateTime @default(now())
  notes               String?
  
  // WhatsApp Integration
  whatsapp_sent       Boolean  @default(false)
  whatsapp_msg_id     String?
  whatsapp_sent_at    DateTime?
  
  // Phase 1C Part 3 Fields
  conversation_score  Float?   // 0-100
  intent_type         String?  // detected primary intent
  engagement_metrics  Json?    // store metrics object
  lead_temperature    String?  // HOT, WARM, COLD
  score_updated_at    DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  interviews          Interview[]
  interviewSchedules  InterviewSchedule[]
}

model CandidateScore {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String?
  overall_score       Float    @default(0) // 0-100
  skills_score        Float    @default(0)
  experience_score    Float    @default(0)
  cultural_fit        Float    @default(0)
  education_score     Float    @default(0)
  location_match      Float    @default(0)
  scoring_method      String   @default("rule_based") // rule_based, ml_model
  feedback            String?
  scored_at           DateTime @default(now())

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job?      @relation(fields: [job_id], references: [id], onDelete: SetNull)
}

model Interview {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String
  application_id      String?
  interview_type      String   // phone_screening, technical, hr, final
  scheduled_at        DateTime?
  completed_at        DateTime?
  interviewer         String?
  rating              Float?   // 0-10
  feedback            String?
  status              String   @default("scheduled") // scheduled, completed, cancelled, no_show
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  application         Application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
}

model InterviewSchedule {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String
  application_id      String?
  interview_date      DateTime?
  interview_time      String?  // "14:00"
  duration_minutes    Int      @default(30)
  timezone            String   @default("Asia/Dubai")
  interview_type      String   // phone_screening, technical, hr, final
  interviewer_ids     String[] // Array of interviewer IDs
  
  // Session Status
  session_status      String   @default("pending_scheduling") // pending_scheduling, scheduled, completed, declined
  available_slots     Json?    // Array of slot options
  selected_slot       Json?    // Selected slot object
  decline_reason      String?
  
  // WhatsApp Integration
  whatsapp_sent       Boolean  @default(false)
  whatsapp_msg_id     String?
  reminder_sent_at    DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  application         Application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
}

model LeadScore {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String
  overall_score       Float    // 0-100 - Main lead quality score
  score_breakdown     Json     // {resumeScore, conversationScore, intentScore, engagementVelocity, sentimentScore}
  lead_temperature    String   // HOT, WARM, COLD
  qualification_level String   // Excellent, Good, Fair, Weak, Poor
  recommendations     Json     // Array of recommendation objects
  
  // Trend Tracking
  score_history       Json?    // Array of historical scores for trend analysis
  engagement_velocity Float?   // Rate of change in engagement (positive/negative/stable)
  qualified_for_roles String[] // Roles this lead is qualified for
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([lead_temperature])
  @@index([overall_score])
  @@index([job_id])
}

model ConversationMetric {
  id                  String   @id @default(uuid()) @map("_id")
  candidate_id        String
  job_id              String
  message_count       Int
  avg_response_time   Float    // in minutes
  avg_message_length  Int      // in characters
  engagement_score    Float    // 0-100
  sentiment_avg       Float    // -1 to 1
  conversation_duration Json   // {days, hours, minutes, totalMinutes}
  activity_trend      String   // Increasing, Decreasing, Stable
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  candidate           Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                 Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([candidate_id])
  @@index([job_id])
}

model RecruitmentMetric {
  id                  String   @id @default(uuid()) @map("_id")
  metric_date         DateTime @default(now())
  total_applications  Int      @default(0)
  applications_screened Int    @default(0)
  applications_rejected Int    @default(0)
  interviews_scheduled Int    @default(0)
  interviews_completed Int    @default(0)
  offers_made         Int      @default(0)
  hires               Int      @default(0)
  avg_time_to_hire    Float?   // in days
  avg_cost_per_hire   Float?
  automation_percentage Float? // 0-100
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

  // ─── Wave 12: Property Valuation ─────────────────────────────────────────────
  model PropertyValuation {
    id                String    @id @default(auto()) @map("_id") @db.ObjectId
    propertyId        String    @db.ObjectId
    estimatedValueAed Float
    rentAnnualAed     Float
    grossYieldPct     Float
    netYieldPct       Float
    confidence        String    // high | medium | low
    method            String    // avm | manual_override | bank
    comparables       Json      @default("[]")
    ageDiscount       Float     @default(0)
    amenityPremium    Float     @default(0)
    priceRangeLow     Float?
    priceRangeHigh    Float?
    overrideReason    String?
    overriddenById    String?   @db.ObjectId
    bankRequestStatus String?   // pending | submitted | received
    bankResponseAed   Float?
    bankRequestedAt   DateTime?
    bankRespondedAt   DateTime?
    createdById       String    @db.ObjectId
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    property     Property @relation("PropertyValuations", fields: [propertyId], references: [id], onDelete: Cascade)
    createdBy    User     @relation("ValuationCreator", fields: [createdById], references: [id])
    overriddenBy User?    @relation("ValuationOverrider", fields: [overriddenById], references: [id])

    @@index([propertyId])
    @@index([createdAt])
    @@index([method])
  }

  // ─── Wave 12: Market Snapshot ─────────────────────────────────────────────────
  model MarketSnapshot {
    id               String   @id @default(auto()) @map("_id") @db.ObjectId
    snapshotDate     DateTime @default(now())
    area             String
    propertyType     String   // apartment | villa | townhouse | penthouse | all
    avgPricePerSqft  Float
    avgSalePrice     Float
    avgAnnualRent    Float
    grossYield       Float
    transactionVol   Int      @default(0)
    daysOnMarket     Float    @default(0)
    absorptionRate   Float    @default(0)
    newListings      Int      @default(0)
    activeListings   Int      @default(0)
    source           String   @default("dld")
    notes            String?
    createdAt        DateTime @default(now())

    @@index([area, snapshotDate])
    @@index([snapshotDate])
    @@index([area])
  }

// ─── CADENCE RULE ────────────────────────────────────────────────────────────

model CadenceRule {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  isActive        Boolean   @default(true)
  priority        Int       @default(0)

  // Matching conditions (empty = match all)
  leadTiers       String[]  // e.g. ["hot","warm"]
  leadSources     String[]  // e.g. ["whatsapp","website"]
  dealTypes       String[]  // e.g. ["sale","lease"]

  // Channel sequence — JSON array of CadenceRuleStep
  channelSequence Json

  // Guard rails (times in HH:mm, GST = UTC+4)
  quietHoursStart String?
  quietHoursEnd   String?
  dailyCapPerLead Int       @default(3)
  cooldownHours   Int       @default(24)

  createdById     String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([isActive, priority])
  @@index([createdAt])
}
