
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ────────────────────────────────────────────────────────

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String?
  photoUrl     String?
  role         String   @default("agent") // owner, agent, viewer
  phone        String?
  department   String?
  status       String   @default("active")
  passwordHash String?  // bcrypt hash — null means password not set yet
  firebaseUid  String?  // Firebase UID for social/phone auth sync (optional, indexed but not unique)
  brnNumber    String?  // RERA Broker Registration Number
  brnExpiry    DateTime? // BRN expiry date
  reraLicenseNumber String? // RERA Brokerage License Number
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties    Property[]
  leadsAssigned Lead[]       @relation("AssignedAgent")
  leadsCreated  Lead[]       @relation("CreatedBy")
  activities    Activity[]
  transactions  Transaction[] @relation("TransactionAgent")
  commissions   Commission[]
  favorites     Favorite[]
  savedSearches SavedSearch[]
  viewings      Viewing[]    @relation("ViewingUser")
  assignedViewings Viewing[] @relation("ViewingAgent")
  agentAvailability AgentAvailability[]
  offersAsBuyer Offer[]      @relation("OfferBuyer")
  leasesAsTenant Lease[]     @relation("LeaseTenant")
  leasesAsLandlord Lease[]   @relation("LeaseLandlord")
  maintenanceRequests Maintenance[] @relation("MaintenanceRequester")

  @@index([role])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([firebaseUid])
}

// ─── PROPERTY ───────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        String   @default("apartment") // villa, apartment, penthouse, commercial, land, townhouse
  status      String   @default("available")  // available, reserved, sold, rented, off_market
  price       Float
  currency    String   @default("AED")  // AED, USD, EUR, GBP, INR
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  sqft        Int      @default(0)
  location    String
  area        String?
  amenities   String[]
  images      String[]
  featured    Boolean  @default(false)
  agentName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  leads       Lead[]
  transactions Transaction[]
  tenants      Tenant[]
  commissions  Commission[]
  favorites    Favorite[]
  viewings     Viewing[]
  offers       Offer[]
  leases       Lease[]
  maintenanceRequests Maintenance[]

  @@index([status])
  @@index([type])
  @@index([featured])
  @@index([createdAt])
  @@index([price])
  @@index([userId])
  @@index([area])
}

// ─── LEAD ───────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("new") // new, contacted, qualified, hot, warm, cold, won, lost
  source      String   @default("direct") // whatsapp, website, phone, referral, marketing, direct
  budget      Float?
  budgetCurrency String @default("AED")  // AED, USD, EUR, GBP, INR
  score       Int      @default(0) // 0-100 lead score
  scoreBreakdown Json?  // { engagement, demographic, behavioral, source, lastScoredAt }
  scoreTier   String   @default("cold") // hot (80+), warm (60-79), cold (<60), inactive
  lastScoredAt DateTime?
  notes       String?
  tags        String[]
  lastContact DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignedToId String?  @db.ObjectId
  assignedTo   User?    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  createdById  String?  @db.ObjectId
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id])
  propertyId   String?  @db.ObjectId
  property     Property? @relation(fields: [propertyId], references: [id])
  activities   Activity[]
  transactions Transaction[]
  commissions  Commission[]
  viewings     Viewing[]
  offers       Offer[]
  followUpSequences FollowUpSequence[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([createdById])
  @@index([createdAt])
  @@index([score])
  @@index([propertyId])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([assignedToId, status])
  @@index([status, source, createdAt])
}

// ─── LEAD SCORE HISTORY ─────────────────────────────────────────────────

model LeadScoreHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId      String   @db.ObjectId
  score       Int      // 0-100
  tier        String   // hot, warm, cold, inactive
  previousScore Int    // Previous score for delta tracking
  previousTier  String // Previous tier for transition tracking
  breakdown   Json?    // { engagement, demographic, behavioral, source }
  trigger     String   // middleware, batch, manual, override, whatsapp
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@index([leadId, createdAt])
}

// ─── ACTIVITY ───────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // lead, property, deal, commission, agent, client, system
  action      String   // created, updated, deleted, status_changed, note_added, call, email, visit
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])

  @@index([type])
  @@index([action])
  @@index([type, action])  // Composite for filtered queries
  @@index([userId])
  @@index([leadId])
  @@index([createdAt])
}

// ─── TRANSACTION ────────────────────────────────────────────────────────

model Transaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   @default("sale")  // sale, rental, lease
  status        String   @default("draft") // draft, pending, in_progress, completed, cancelled
  amount        Float
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  closingDate   DateTime?
  notes         String?
  documents     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?     @relation(fields: [leadId], references: [id])
  agentId       String?  @db.ObjectId
  agent         User?     @relation("TransactionAgent", fields: [agentId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([propertyId])
  @@index([agentId])
  @@index([leadId])
}

// ─── TENANT ─────────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String?
  phone         String?
  nationality   String?
  emiratesId    String?
  status        String   @default("active") // active, inactive, pending
  moveInDate    DateTime?
  moveOutDate   DateTime?
  monthlyRent   Float?
  deposit       Float?
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])

  @@index([status])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── NADIA: WHATSAPP WEBHOOK & ROUTING ──────────────────────────────────────

model NadiaConversation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  wabaId      String   // Meta WABA ID
  customerPhone String  // Customer's WhatsApp number
  agentPhone  String?  // Assigned agent phone (if assigned)
  
  // Message history
  messages    NadiaMessage[]
  queue       NadiaConversationQueue?
  
  // NLP & Routing
  intent      String?  // From Nina: property_search, schedule_tour, etc.
  leadScore   Int      @default(0) // 0-100 from Nina
  timeline    String?  // From Nina: ASAP, 1-3mo, etc.
  
  // Status
  status      String   @default("active") // active, assigned_to_agent, in_bot_flow, closed
  routedAt    DateTime?
  closedAt    DateTime?
  closedReason String?  // why conversation closed
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([customerPhone])
  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
  @@index([agentPhone])
}

model NadiaMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String @db.ObjectId
  conversation NadiaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  waMessageId String   // Message ID from Meta WhatsApp
  direction   String   // inbound | outbound
  body        String
  messageType String   @default("text") // text, image, document, audio, video
  
  status      String   @default("sent") // sent, delivered, read, failed
  
  timestamp   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([conversationId])
  @@index([status])
  @@index([timestamp])
}

model NadiaConversationQueue {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @unique @db.ObjectId
  conversation    NadiaConversation @relation(fields: [conversationId], references: [id])
  
  priority        Int      // 1-10, higher = better
  status          String   @default("waiting") // waiting, assigned, completed
  assignedTo      String?  // Agent phone if assigned
  assignedAt      DateTime?
  queuedAt        DateTime @default(now())
  completedAt     DateTime?
  
  // SLA tracking
  responseTime    Int?     // milliseconds
  
  @@index([status])
  @@index([priority])
  @@index([queuedAt])
}

// ─── COMMISSION ─────────────────────────────────────────────────────────

model Commission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  amount      Float
  currency    String   @default("AED")  // AED, USD, EUR, GBP, INR
  percentage  Float?   // Commission percentage (0-100), optional
  type        String   @default("sale")      // sale, rental, referral
  status      String   @default("pending")   // pending, approved, paid, cancelled
  notes       String?
  paidAt      DateTime?
  vatRate     Float?   @default(5)  // VAT percentage: 0% residential, 5% commercial, 5% on commission
  vatAmount   Float?   @default(0)  // Calculated VAT amount
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agentId     String   @db.ObjectId
  agent       User     @relation(fields: [agentId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])
  propertyId  String?  @db.ObjectId
  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([agentId, status])  // Composite for agent performance queries
  @@index([propertyId])
  @@index([leadId])
}

// ─── FAVORITE ───────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())

  // Relations
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId]) // One favorite per user per property
  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── SAVED SEARCH ───────────────────────────────────────────────────────

model SavedSearch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // e.g. "3BR apartments in JBR under 2M"
  filters     Json     // { type, minPrice, maxPrice, bedrooms, location, area, ... }
  alertEnabled Boolean @default(false) // Notify user when new matches appear
  lastChecked DateTime?
  matchCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([alertEnabled])
  @@index([createdAt])
}

// ─── VIEWING ────────────────────────────────────────────────────────────

model Viewing {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  scheduledAt   DateTime
  duration      Int       @default(30)  // minutes
  status        String    @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show
  type          String    @default("in_person") // in_person, virtual, open_house
  notes         String?
  feedback      String?   // Post-viewing feedback
  rating        Int?      // 1-5 star rating
  location      String?   // Meeting point or virtual link
  reminderSent  Boolean   @default(false)  // Whether reminder notification was sent
  confirmedAt   DateTime? // When the viewing was confirmed
  cancelReason  String?   // Reason for cancellation
  icsToken      String?   // Unique token for .ics calendar download
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId        String   @db.ObjectId
  user          User     @relation("ViewingUser", fields: [userId], references: [id])
  agentId       String?  @db.ObjectId
  agent         User?    @relation("ViewingAgent", fields: [agentId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?    @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([agentId])
  @@index([propertyId])
  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// ─── AGENT AVAILABILITY ─────────────────────────────────────────────────

model AgentAvailability {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek     Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime     String   // HH:mm format (e.g. "09:00")
  endTime       String   // HH:mm format (e.g. "18:00")
  isActive      Boolean  @default(true)
  slotDuration  Int      @default(30)  // minutes per slot
  breakStart    String?  // Break start time HH:mm (e.g. "12:00")
  breakEnd      String?  // Break end time HH:mm (e.g. "13:00")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  agentId       String   @db.ObjectId
  agent         User     @relation(fields: [agentId], references: [id])

  @@unique([agentId, dayOfWeek])
  @@index([agentId])
  @@index([dayOfWeek])
}

// ─── OFFER ──────────────────────────────────────────────────────────────

model Offer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  status        String   @default("pending") // pending, accepted, rejected, countered, expired, withdrawn
  expiresAt     DateTime?
  terms         String?  // Free-text negotiation terms
  counterAmount Float?   // Counter-offer amount
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  buyerId       String   @db.ObjectId
  buyer         User     @relation("OfferBuyer", fields: [buyerId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?    @relation(fields: [leadId], references: [id])

  @@index([buyerId])
  @@index([propertyId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

// ─── LEASE ──────────────────────────────────────────────────────────────

model Lease {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  leaseNumber   String?
  startDate     DateTime
  endDate       DateTime
  monthlyRent   Float
  depositAmount Float    @default(0)
  currency      String   @default("AED")  // AED, USD, EUR, GBP, INR
  status        String   @default("draft") // draft, active, expiring, expired, terminated, renewed
  terms         String?
  documents     String[]
  nextPaymentDue DateTime?
  ejariNumber   String?   // Ejari registration number
  ejariStatus   String?   @default("pending") // pending, registered, expired, cancelled
  ejariRegistrationDate DateTime? // When Ejari was registered
  ejariExpiryDate DateTime? // When Ejari registration expires
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenantId      String   @db.ObjectId
  tenant        User     @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId    String   @db.ObjectId
  landlord      User     @relation("LeaseLandlord", fields: [landlordId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
  @@index([endDate])
  @@index([createdAt])
}

// ─── MAINTENANCE ────────────────────────────────────────────────────────

model Maintenance {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  category      String   @default("general") // plumbing, electrical, hvac, appliance, structural, general
  priority      String   @default("medium")  // low, medium, high, emergency
  status        String   @default("open")    // open, in_progress, scheduled, completed, cancelled
  scheduledDate DateTime?
  completedAt   DateTime?
  cost          Float?
  costCurrency  String   @default("AED")  // AED, USD, EUR, GBP, INR
  images        String[]
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  requesterId   String   @db.ObjectId
  requester     User     @relation("MaintenanceRequester", fields: [requesterId], references: [id])
  propertyId    String   @db.ObjectId
  property      Property @relation(fields: [propertyId], references: [id])

  @@index([requesterId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

// ─── JOB APPLICATION ────────────────────────────────────────────────────

model JobApplication {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  phone         String?
  position      String
  experience    String?
  resumeUrl     String?
  coverLetter   String?
  status        String   @default("received") // received, reviewed, shortlisted, interview, offered, hired, rejected
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([position])
  @@index([email])
  @@index([createdAt])
}

// ─── INVOICE ────────────────────────────────────────────────────────────

// ─── CLIENT ─────────────────────────────────────────────────────────────

model Client {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String?
  phone               String?
  company             String?
  category            String   @default("buyer")      // buyer, seller, landlord, tenant, investor
  status              String   @default("active")      // active, inactive, prospect, archived
  type                String   @default("individual")  // individual, corporate, investment_firm
  nationality         String?
  totalValue          Float    @default(0)             // total deal value
  totalValueCurrency  String   @default("AED")          // AED, USD, EUR, GBP, INR
  dealsCount          Int      @default(0)
  notes               String?
  tags                String[]
  lastContact         DateTime?
  convertedFromLeadId String?  @db.ObjectId            // if converted from a Lead
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations (agent ref stored as plain ID — no FK constraint)
  assignedToId        String?  @db.ObjectId
  communications      Communication[]
  clientProperties    ClientProperty[]

  @@index([category])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([email])
  @@index([createdAt])
}

// ─── CLIENT ↔ PROPERTY JUNCTION ─────────────────────────────────────────

model ClientProperty {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String   @db.ObjectId
  client          Client   @relation(fields: [clientId], references: [id])
  propertyId      String   @db.ObjectId          // plain ref — avoids modifying Property model
  relationship    String   @default("interested") // owner, tenant, buyer, interested, previous_owner, previous_tenant
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([clientId, propertyId])
  @@index([clientId])
  @@index([propertyId])
  @@index([relationship])
}

// ─── COMMUNICATION LOG ──────────────────────────────────────────────────

model Communication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id])
  type        String   @default("note")      // call, email, whatsapp, meeting, note, sms
  direction   String   @default("outbound")  // inbound, outbound
  subject     String?
  body        String?
  duration    Int?                            // seconds (for calls/meetings)
  outcome     String?                         // interested, follow_up, not_available, closed, no_answer
  createdAt   DateTime @default(now())

  // Who logged it (plain ID — no FK constraint)
  createdById String?  @db.ObjectId

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
}

// ─── INVOICE ────────────────────────────────────────────────────────────

model Invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String   @unique           // "INV-2026-0001"
  client        String                     // Client name
  property      String?                    // Property reference
  amount        Float
  vatAmount     Float    @default(0)       // 5% VAT for commercial
  totalAmount   Float                      // amount + vatAmount
  currency      String   @default("AED")
  status        String   @default("draft") // draft, pending, paid, overdue, cancelled, refunded
  date          DateTime @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?
  lineItems     Json?                      // [{ description, qty, unitPrice, total }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdById   String?  @db.ObjectId

  @@index([status])
  @@index([client])
  @@index([dueDate])
  @@index([createdAt])
}

// ─── EXPENSE ────────────────────────────────────────────────────────────

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String                     // Marketing, Maintenance, Utilities, Salaries, Office, Legal, Insurance
  description   String
  amount        Float
  currency      String   @default("AED")
  status        String   @default("pending") // pending, approved, rejected, processed, reimbursed
  date          DateTime @default(now())
  receiptUrl    String?                    // Receipt/document upload
  notes         String?
  approvedById  String?  @db.ObjectId
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdById   String?  @db.ObjectId

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([createdAt])
  @@index([approvedById])
}

// ─── FOLLOW-UP SEQUENCE ─────────────────────────────────────────────────

model FollowUpSequence {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cadenceType   String   // hot, warm, cold, custom
  status        String   @default("active") // active, paused, completed, cancelled
  currentStep   Int      @default(0)
  totalSteps    Int      @default(4)
  startedAt     DateTime @default(now())
  pausedAt      DateTime?
  completedAt   DateTime?
  nextStepAt    DateTime? // when the next step should fire
  metadata      Json?    // custom overrides, notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  leadId        String   @db.ObjectId
  lead          Lead     @relation(fields: [leadId], references: [id])
  createdById   String?  @db.ObjectId
  steps         FollowUpStep[]

  @@index([status])
  @@index([cadenceType])
  @@index([leadId])
  @@index([nextStepAt])
  @@index([status, nextStepAt])
}

model FollowUpStep {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  stepNumber    Int      // 1, 2, 3, 4...
  channel       String   // whatsapp, email, call, sms
  status        String   @default("pending") // pending, scheduled, sent, delivered, failed, skipped
  scheduledAt   DateTime?
  executedAt    DateTime?
  templateName  String?  // e.g. "follow_up_viewing", "initial_contact"
  message       String?  // actual message content (if custom)
  result        String?  // response outcome: replied, no_response, bounced, call_answered, call_no_answer
  errorMessage  String?  // if failed
  metadata      Json?    // messageId, deliveryStatus, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sequenceId    String   @db.ObjectId
  sequence      FollowUpSequence @relation(fields: [sequenceId], references: [id])

  @@index([sequenceId])
  @@index([status])
  @@index([stepNumber])
  @@index([scheduledAt])
  @@index([channel])
}

// ─── WEBAUTHN CREDENTIAL ────────────────────────────────────────────────

model WebAuthnCredential {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  credentialId    String   @unique      // base64url-encoded credential ID
  publicKey       String               // base64url-encoded public key (COSE format)
  counter         Int      @default(0) // signature counter for replay protection
  deviceType      String?              // "platform" | "cross-platform"
  transports      String[]             // ["internal", "usb", ...]
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

// ─── DOCUMENT ───────────────────────────────────────────────────────────

model Document {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   // mou, form_f, noc, commission_invoice, viewing_report, offer_letter
  title         String
  version       Int      @default(1)
  status        String   @default("draft") // draft, final, signed, archived
  htmlContent   String   // rendered HTML content
  metadata      Json?    // template variables, generation context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Related entities (optional — a document may link to any combination)
  transactionId String?  @db.ObjectId
  leadId        String?  @db.ObjectId
  propertyId    String?  @db.ObjectId
  commissionId  String?  @db.ObjectId
  generatedById String?  @db.ObjectId

  @@index([type])
  @@index([status])
  @@index([transactionId])
  @@index([leadId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── CONTRACT ───────────────────────────────────────────────────────────

model Contract {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  contractNumber   String   @unique            // "WC-C-2026-0001"
  type             String   @default("sale")   // sale, rental, mou, form_f, listing, management
  status           String   @default("draft")  // draft, pending_signature, active, expired, terminated, cancelled
  title            String
  description      String?
  value            Float?                       // contract value (AED)
  currency         String   @default("AED")
  startDate        DateTime?
  endDate          DateTime?
  signedAt         DateTime?
  terminatedAt     DateTime?
  terminationReason String?
  parties          Json?                        // [{ role, name, email, phone }]
  terms            String?                      // free-text contract terms / notes
  attachmentUrls   String[]                     // uploaded document URLs
  metadata         Json?                        // extra key/value pairs

  // Relations
  propertyId       String?  @db.ObjectId
  leadId           String?  @db.ObjectId
  transactionId    String?  @db.ObjectId
  createdById      String?  @db.ObjectId
  assignedToId     String?  @db.ObjectId

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([propertyId])
  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

// ─── APPOINTMENT ────────────────────────────────────────────────────────

model Appointment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  type           String   @default("viewing")  // viewing, meeting, call, inspection, signing
  status         String   @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show
  scheduledAt    DateTime
  durationMins   Int      @default(60)
  location       String?
  notes          String?
  cancelReason   String?
  reminderSentAt DateTime?
  completedAt    DateTime?

  // Participants
  clientName     String?
  clientEmail    String?
  clientPhone    String?
  agentId        String?  @db.ObjectId
  propertyId     String?  @db.ObjectId
  leadId         String?  @db.ObjectId
  createdById    String?  @db.ObjectId

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([agentId])
  @@index([propertyId])
  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

// ─── ROLE REQUEST ───────────────────────────────────────────────────────

model RoleRequest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  requestedRole  String                         // role being requested
  currentRole    String                         // user's current role at time of request
  reason         String?                        // why they need this role
  status         String   @default("pending")   // pending, approved, rejected
  reviewNote     String?                        // admin notes on decision
  reviewedById   String?  @db.ObjectId
  reviewedAt     DateTime?

  userId         String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestedRole])
  @@index([createdAt])
}
