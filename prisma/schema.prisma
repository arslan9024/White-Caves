
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ────────────────────────────────────────────────────────

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String?
  photoUrl     String?
  role         String   @default("agent") // owner, agent, viewer
  phone        String?
  department   String?
  status       String   @default("active")
  passwordHash String?  // bcrypt hash — null means password not set yet
  firebaseUid  String?  @unique // Firebase UID for social/phone auth sync
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties    Property[]
  leadsAssigned Lead[]       @relation("AssignedAgent")
  leadsCreated  Lead[]       @relation("CreatedBy")
  activities    Activity[]
  commissions   Commission[]
  transactions  Transaction[] @relation("TransactionAgent")

  @@index([role])
  @@index([status])
  @@index([department])
  @@index([createdAt])
}

// ─── PROPERTY ───────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        String   @default("apartment") // villa, apartment, penthouse, commercial, land, townhouse
  status      String   @default("available")  // available, reserved, sold, rented, off_market
  price       Float
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  sqft        Int      @default(0)
  location    String
  area        String?
  amenities   String[]
  images      String[]
  featured    Boolean  @default(false)
  agentName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  leads       Lead[]
  commissions Commission[]
  transactions Transaction[]
  tenants      Tenant[]

  @@index([status])
  @@index([type])
  @@index([featured])
  @@index([createdAt])
  @@index([price])
  @@index([userId])
  @@index([area])
}

// ─── LEAD ───────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("new") // new, contacted, qualified, hot, warm, cold, won, lost
  source      String   @default("direct") // whatsapp, website, phone, referral, marketing, direct
  budget      Float?
  score       Int      @default(0) // 0-100 lead score
  notes       String?
  tags        String[]
  lastContact DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignedToId String?  @db.ObjectId
  assignedTo   User?    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  createdById  String?  @db.ObjectId
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id])
  propertyId   String?  @db.ObjectId
  property     Property? @relation(fields: [propertyId], references: [id])
  activities   Activity[]
  commissions  Commission[]
  transactions Transaction[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([createdById])
  @@index([createdAt])
  @@index([score])
  @@index([propertyId])
}

// ─── COMMISSION ─────────────────────────────────────────────────────────

model Commission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  amount      Float
  percentage  Float?
  status      String   @default("pending") // pending, approved, paid, cancelled
  type        String   @default("sale") // sale, rental, referral
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  agentId     String   @db.ObjectId
  agent       User     @relation(fields: [agentId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])
  propertyId  String?  @db.ObjectId
  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@index([leadId])
  @@index([propertyId])
  @@index([agentId, leadId, propertyId])  // Composite index for duplicate detection
}

// ─── ACTIVITY ───────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // lead, property, deal, commission, agent, client, system
  action      String   // created, updated, deleted, status_changed, note_added, call, email, visit
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  leadId      String?  @db.ObjectId
  lead        Lead?    @relation(fields: [leadId], references: [id])

  @@index([type])
  @@index([action])
  @@index([type, action])  // Composite for filtered queries
  @@index([userId])
  @@index([leadId])
  @@index([createdAt])
}

// ─── TRANSACTION ────────────────────────────────────────────────────────

model Transaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   @default("sale")  // sale, rental, lease
  status        String   @default("draft") // draft, pending, in_progress, completed, cancelled
  amount        Float
  closingDate   DateTime?
  notes         String?
  documents     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])
  leadId        String?  @db.ObjectId
  lead          Lead?     @relation(fields: [leadId], references: [id])
  agentId       String?  @db.ObjectId
  agent         User?     @relation("TransactionAgent", fields: [agentId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([propertyId])
  @@index([agentId])
  @@index([leadId])
}

// ─── TENANT ─────────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String?
  phone         String?
  nationality   String?
  emiratesId    String?
  status        String   @default("active") // active, inactive, pending
  moveInDate    DateTime?
  moveOutDate   DateTime?
  monthlyRent   Float?
  deposit       Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  propertyId    String?  @db.ObjectId
  property      Property? @relation(fields: [propertyId], references: [id])

  @@index([status])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── CLIENT / OWNER ─────────────────────────────────────────────────────

model Client {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String?
  phone         String?
  type          String   @default("buyer") // buyer, seller, owner, investor
  nationality   String?
  emiratesId    String?
  company       String?
  status        String   @default("active") // active, inactive, vip
  notes         String?
  address       String?
  propertyIds   String[] @db.ObjectId
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ─── NOTIFICATION ───────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  type        String   @default("info") // info, success, warning, error, lead, property, commission, system
  channel     String   @default("in_app") // in_app, email, whatsapp
  title       String
  message     String
  read        Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([userId, read])
  @@index([createdAt])
}

// ─── FAVORITE ───────────────────────────────────────────────────────────

model Favorite {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  propertyId  String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}
