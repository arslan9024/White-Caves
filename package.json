{
  "name": "white-caves-real-estate",
  "version": "1.0.0",
  "type": "module",
  "description": "White Caves Real Estate - Dubai's Premier Luxury Property Platform",
  "homepage": ".",
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:linda": "cd modules/linda && npm run dev",
    "dev:henry": "cd modules/henry && cross-env HENRY_PORT=5100 npm run dev",
    "dev:ai-modules": "concurrently \"npm run dev:linda\" \"npm run dev:henry\"",
    "install:linda": "cd modules/linda && npm install",
    "install:henry": "cd modules/henry && npm install",
    "install:ai-modules": "npm run install:linda && npm run install:henry",
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "vercel-build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:ops": "vitest run server/__tests__/generate-seo-assets.script.test.ts server/__tests__/verify-deployment.script.test.ts server/__tests__/verify-runtime-endpoints.script.test.ts",
