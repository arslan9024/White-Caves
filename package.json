{
  "name": "white-caves-real-estate",
  "version": "1.0.0",
  "type": "module",
  "description": "White Caves Real Estate - Dubai's Premier Luxury Property Platform",
  "homepage": ".",
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "vercel-build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:ops": "vitest run server/__tests__/generate-seo-assets.script.test.ts server/__tests__/verify-deployment.script.test.ts server/__tests__/verify-runtime-endpoints.script.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test src/e2e/accessibility.audit.spec.ts --reporter=html",
    "test:e2e:performance": "playwright test src/e2e/performance.layer5.spec.ts --reporter=html",
    "test:e2e:performance:json": "playwright test src/e2e/performance.layer5.spec.ts --reporter=json",
    "test:e2e:smoke": "playwright test src/e2e/dashboard.spec.ts --reporter=html",
    "quality:seo": "npm run seo:generate && npm run test:ops",
    "quality:quick": "npm run lint && npm run build && npm run test:ops",
    "e2e": "playwright test",
    "e2e:run": "playwright test --reporter=html",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:performance": "playwright test src/e2e/performance.layer5.spec.ts",
    "coverage:full": "npm run test:coverage && npm run e2e:performance",
    "generate-pdf": "node scripts/generate-company-pdf.js",
    "validate": "node scripts/validate-code.js",
    "verify-deploy": "node scripts/verify-deployment.js",
    "verify:runtime": "node scripts/verify-runtime-endpoints.js",
    "verify:runtime:dry": "node scripts/verify-runtime-endpoints.js --url=https://whitecaves.com --dry-run",
    "seo:generate": "node scripts/generate-seo-assets.js",
    "seo:generate:staging": "node scripts/generate-seo-assets.js --domain=https://staging.whitecaves.com",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "server:api": "tsx server/index.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:enhanced": "tsx prisma/seed-enhanced.ts",
    "db:seed:small": "tsx prisma/seed-enhanced.ts --count small",
    "db:seed:large": "tsx prisma/seed-enhanced.ts --count large",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/morgan": "^1.9.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.11.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@reduxjs/toolkit": "^2.7.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.24.10",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ics": "^3.11.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "morgan": "^1.10.1",
    "prisma": "^6.6.0",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.0",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.3.11",
    "web-vitals": "^5.1.0",
    "whatsapp-web.js": "^1.34.6"
  }
}
