{
  "name": "white-caves-real-estate",
  "version": "1.0.0",
  "type": "module",
  "description": "White Caves Real Estate - Dubai's Premier Luxury Property Platform",
  "homepage": ".",
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "client": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "build:vercel": "vite build && npm run build:api",
    "build:api": "echo 'API ready for serverless'",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "vercel-build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:api": "vitest run src/__tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "coverage:c8": "c8 --reporter=text --reporter=lcov --reporter=html node node_modules/vitest/vitest.mjs run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:test": "docker-compose -f docker-compose.dev.yml run app npm test",
    "generate-pdf": "node scripts/generate-company-pdf.js",
    "validate": "node scripts/validate-code.js",
    "verify-deploy": "node scripts/verify-deployment.js",
    "seed": "node scripts/seedDatabase.js --clear",
    "seed:small": "node scripts/seedDatabase.js --clear --count 20",
    "seed:large": "node scripts/seedDatabase.js --clear --count 200"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^1.0.0",
    "c8": "^10.1.3",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.6.0",
    "@react-google-maps/api": "^2.20.6",
    "@reduxjs/toolkit": "^2.7.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.24.10",
    "fs-extra": "^11.3.3",
    "googleapis": "^164.1.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "mongoose": "^8.14.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.394",
    "prisma": "^6.6.0",
    "qrcode-terminal": "^0.12.0",
    "react-pdf": "^10.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.6.0",
    "signature_pad": "^5.1.1",
    "stripe": "^19.2.0",
    "styled-components": "^6.3.8",
    "swiper": "^12.0.3",
    "uuid": "^13.0.0",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0",
    "whatsapp-web.js": "^1.34.4",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
