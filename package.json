    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sentiment": "^5.0.2",
    "signature_pad": "^5.1.1",
    "stripe": "^19.2.0",
    "swiper": "^12.0.3",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0",
    "whatsapp-web.js": "^1.34.4",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  }
}
