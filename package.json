{
  "name": "white-caves-real-estate",
  "version": "1.0.0",
  "type": "module",
  "description": "White Caves Real Estate - Dubai's Premier Luxury Property Platform",
  "homepage": ".",
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:linda": "cd modules/linda && npm run dev",
    "dev:henry": "cd modules/henry && cross-env HENRY_PORT=5100 npm run dev",
    "dev:ai-modules": "concurrently \"npm run dev:linda\" \"npm run dev:henry\"",
    "install:linda": "cd modules/linda && npm install",
    "install:henry": "cd modules/henry && npm install",
    "install:ai-modules": "npm run install:linda && npm run install:henry",
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev:client": "vite",
    "dev:server": "nodemon",
    "dev:all": "npm run dev",
    "build": "vite build",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "vercel-build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:c8": "c8 --reporter=text --reporter=lcov --reporter=html node node_modules/vitest/vitest.mjs run",
    "test:ui": "vitest --ui",
    "generate-pdf": "node scripts/generate-company-pdf.js",
    "resources:setup": "node scripts/setup-free-resources.js",
    "resources:download": "node scripts/download-external-data.js",
    "resources:update": "node scripts/update-resources.js",
    "validate": "node scripts/validate-code.js",
    "verify-deploy": "node scripts/verify-deployment.js",
    "seed": "node scripts/seedDatabase.js --clear",
    "seed:small": "node scripts/seedDatabase.js --clear --count 20",
    "seed:large": "node scripts/seedDatabase.js --clear --count 200"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "3.2.4",
    "c8": "^10.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@reduxjs/toolkit": "^2.7.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@types/pdfkit": "^0.17.6",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.24.10",
    "fs-extra": "^11.3.5",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ics": "^3.11.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "mongoose": "^8.14.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
