{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Prompt History Entry",
  "type": "object",
  "required": [
    "v",
    "agent",
    "action",
    "target",
    "prompt",
    "lastUsed",
    "successCount",
    "history"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastUsed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "successCount": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "v",
          "prompt",
          "date"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
