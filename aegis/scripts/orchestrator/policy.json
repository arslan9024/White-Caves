  "aegis": {
    "autoRegenerateWhenQueueComplete": true,
    "maxRegenerationsPerRun": 100000,
    "restartFromNextPhaseWhenQueueComplete": true,
    "nextPhaseRoadmap": [
      "Wave 19 - Identity & Access v2 + CRM Routing + MD Workspace Split",
      "Wave 20 - Security Compliance Schema Blockers",
      "Wave 21 - Backend Contract Hardening + Observability",
      "Wave 22 - KPI Integrity + Executive Intelligence"
    ],
    "smartSelectionEnabled": true,
    "phaseBalanceEnabled": true,
    "targetImplementationSharePct": 60,
    "preflightEnabled": true,
    "autoUnblockSweepEnabled": true,
    "queueHealthEveryNTasks": 3,
    "problemScannerEnabled": false,
    "problemScannerAutoFixEnabled": true,
    "problemScannerEveryNTasks": 3,
    "problemScannerIdleEveryNLoops": 6,
    "developmentSweepEnabled": false,
    "developmentSweepAutoFixEnabled": true,
    "developmentSweepEveryNTasks": 5,
    "developmentSweepIdleEveryNLoops": 10,
    "developmentSweepIncludeE2E": false,
    "developmentSweepIncludeAudit": false,
    "developmentSweepTargetedChecksEnabled": true,
    "developmentSweepTargetedMaxChecks": 4,
    "developmentSweepRiskTierEnabled": true,
    "developmentSweepRiskTierBlockOnMissingRequired": false,
    "developmentSweepRiskProfiles": {
      "security": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "audit"],
        "optionalChecks": ["test:e2e:accessibility"]
      },
      "auth": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "test:assistant-contract"],
        "optionalChecks": ["test:e2e:smoke"]
      },
      "database": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "build"],
        "optionalChecks": []
      },
      "payment": {
        "requiredChecks": ["test:run", "verify:runtime:dry", "build"],
        "optionalChecks": ["audit"]
      },
      "general": {
        "requiredChecks": ["test:run"],
        "optionalChecks": []
      }
    },
    "priorityOverride": {
      "enabled": true,
      "tasks": [
        {
          "agent": "@Mira",
          "lane": "A",
          "phase": "implementation",
          "team": "premium-implementation",
          "priority": "critical",
          "priorityScore": 1000,
          "title": "Wave 19 auth-routing-session foundation",
          "prompt": "@Mira -- PRIORITY IMPLEMENT+VERIFY: Wave 19 auth-routing-session foundation. Execute this before any non-priority queue tasks. Align login success routing, profile completion gate behavior, CRM entry consistency, access-token refresh flow, and session hydration against the current Wave 19 bundle. Include strict validation evidence (typecheck/lint/build/tests), route regression notes, and rollback steps."
        },
        {
          "agent": "@Mala",
          "lane": "B",
          "phase": "implementation",
          "team": "premium-implementation",
          "priority": "critical",
          "priorityScore": 999,
          "title": "Wave 19 superuser dashboard workspace split and executive UX",
          "prompt": "@Mala -- PRIORITY IMPLEMENT+VERIFY: Wave 19 superuser dashboard workspace split and executive UX. Execute this before non-priority queue tasks. Deliver the current canonical MD workspace split, first-screen executive hierarchy, responsive behavior, accessibility states, and premium UX polish defined by the Wave 19 plan and UI/UX business docs. Include validation evidence and rollback notes."
        },
        {
          "agent": "@S5",
          "lane": "A",
          "phase": "implementation",
          "team": "premium-implementation",
          "priority": "critical",
          "priorityScore": 998,
          "title": "Wave 20 P0 security, RBAC, and compliance blocker hardening",
          "prompt": "@S5 -- PRIORITY IMPLEMENT+VERIFY: Wave 20 P0 security, RBAC, and compliance blocker hardening. Execute this before non-priority tasks. Remove known P0 auth/RBAC/compliance blockers from the active implementation path, including route protection mismatches, session security gaps, and enforcement controls required by the canonical plans. Include strict validation evidence, risk notes, and rollback steps."
        }
      ]
    },
    "devSmokeEnabled": true,
    "devSmokeEveryNTasks": 3,
    "devRuntimeCheckEnabled": false,
    "devRuntimeCheckIntervalHours": 2,
    "devRuntimeCheckMaxRunMinutes": 2,
    "devRuntimeCheckRunProblemScan": true,
    "progressIntelligenceEnabled": true,
    "progressIntelligenceEveryNTasks": 1,
    "minLoopImprovementPct": 2,
    "targetProjectBoostPct": 30,
    "progressDriftConsecutiveThreshold": 2,
    "blockerAgingWarnHours": 4,
    "autopilotRequireProducedRef": false,
    "autopilotAutoResolveEvidencePending": false,
