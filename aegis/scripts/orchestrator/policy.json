  "autonomousDefault": false,
  "registryPath": "plans/SUBAGENT_REGISTRY_170.json",
  "agentMesh": {
    "totalAgents": 170,
    "freeAgentCount": 120,
    "premiumAgentCount": 50,
    "squads": 10,
    "squadSize": 12,
    "squadLeads": 10,
    "description": "120 junior/specialist free-model agents + 50 senior/decision-maker premium agents across 10 squads"
  },
  "wavePlanning": {
    "formula": "(freeReadiness >= 100%) AND (squadSynthScore >= 85%)",
    "freeAgentFanout": "All 120 free specialists contribute planning packets per turn",
    "squadSynthPhase": "10 squad leads (premium GPT-4o) synthesize per-squad readiness with mandatory risk notes",
    "waveSize": 10,
    "minimumFreeReadinessPct": 100,
    "minimumSquadSynthPct": 85,
    "visibilityMode": "full-agent-activity"
  },
  "workflow": {
    "planning": {
      "model": "aegis-170-dual-threshold-v3",
      "requiredEvidence": [
        "business-rules",
        "api-contract",
        "data-schema",
        "test-scenario",
        "security-controls",
        "rollback-plan"
      ],
      "validationOrder": [
        "focused-diagnostics",
        "scope-level-checks",
        "workspace-checks",
        "policy-diff-check"
      ],
      "syncCadenceHours": 2
    },
    "development": {
      "deliveryStyle": "vertical-slice",
      "requiredChecks": ["typecheck", "lint", "build", "plans:validate"],
      "targetedTestsRequired": true,
      "maxAutoFixRetries": 3,
      "securityScanRequired": true
    },
    "git": {
      "defaultRemote": "origin",
      "integrationBranch": "develop",
      "integrationFallbackBranches": ["development", "main"],
      "releaseBranch": "main",
      "featureBranchPrefix": "feature/",
      "autoMergeReleaseBranch": false,
      "requirePullRequestForRelease": true
    }
  },
  "workflowGraph": {
    "enabled": true,
    "steps": ["plan", "code", "verify", "merge-ready"],
    "stepPatterns": {
      "sequential": ["plan", "code", "verify", "merge-ready"],
      "parallel": {
        "code": ["frontend", "backend", "tests"]
      },
      "handoff": {
        "plan\u2192code": "@Ada\u2192@Mira",
        "code\u2192verify": "@Mira\u2192@Katherine",
        "verify\u2192merge-ready": "@Katherine\u2192@Gwynne"
      },
      "group-review": {
        "trigger": "high-risk",
        "minRiskScore": 70,
        "reviewers": ["@Ada", "@Katherine", "@Radia"],
        "requiredApprovals": 2
      }
    },
    "stateDir": "logs/orchestrator/workflow-state"
  },
  "checkpoints": {
    "enabled": true,
    "saveOnStepTransition": true,
    "maxCheckpoints": 20,
    "checkpointDir": "logs/orchestrator/checkpoints",
    "autoCheckpointOnHardStop": true
  },
  "hardStops": {
    "stopOnTestFailure": true,
    "stopOnLintFailure": true,
    "stopOnBuildFailure": true,
    "stopOnPolicyMismatch": true,
    "stopOnSecurityScanFailure": true,
    "stopOnHighDiffRisk": true,
    "diffRiskScoreThreshold": 80,
    "flakyTestDetection": {
      "enabled": true,
      "failOnFlaky": false,
      "warnThreshold": 2
    }
  },
  "verification": {
    "diffRiskWeights": {
      "linesChangedScale": 500,
      "highRiskPathWeight": 10
    },
    "tiers": {
      "security": {
        "blockSeverities": ["critical"]
      },
      "auth": {
        "blockSeverities": ["critical", "high"]
      },
      "database": {
        "blockSeverities": ["critical", "high"]
      },
      "payment": {
        "blockSeverities": ["critical", "high"]
      },
      "general": {
        "blockSeverities": ["critical"]
      }
    },
    "exceptions": []
  },
  "rollback": {
    "enabled": true,
    "maxRetriesBeforeRollback": 2,
    "autoRollbackOnMaxRetries": true,
    "fallbackOwner": "@Grace",
    "rollbackPlanDir": "logs/orchestrator/rollback-plans",
    "requireRollbackPlanBeforeExecution": true
  },
  "observability": {
    "tracing": {
      "enabled": true,
      "traceDir": "logs/orchestrator/traces",
      "format": "jsonl",
      "emitOnAgentTurn": true,
      "emitOnHandoff": true,
      "emitOnHardStop": true,
      "retainDays": 30
    },
    "budgetLimits": {
      "enabled": true,
      "maxEstimatedTokensPerSession": 500000,
      "maxRuntimeSeconds": 3600,
      "maxRetriesPerSession": 10,
      "hardCap": true,
      "budgetDir": "logs/orchestrator/budget"
    }
  },
  "benchmark": {
    "enabled": true,
    "cadence": "weekly",
    "metricsDir": "logs/orchestrator/benchmarks",
    "baselineFile": "logs/orchestrator/benchmarks/baseline.json",
    "metrics": ["taskSuccessRate", "passRate", "reworkRate", "cycleTimeSec", "rollbackRate"],
    "regressionAlertThreshold": 0.1
  },
  "confidenceRouting": {
    "enabled": true,
    "autoApproveMinConfidence": 0.8,
    "requireHumanApprovalMaxConfidence": 0.5,
    "riskScoreLowMax": 30,
    "riskScoreHighMin": 70,
    "highRiskDomains": ["security", "auth", "payment", "database-migration"],
    "routingStateDir": "logs/orchestrator/confidence",
    "fallbackDecision": "human-approval",
    "fallbackChain": ["human-approval", "approval", "escalate"],
    "requireReviewMetadataOnUncertain": true,
    "canaryPercentOverride": null
  },
  "artifactSchemasDir": "aegis/orchestrator/schemas",
  "changeLog": [
    {
      "date": "2026-06-17",
      "summary": "Added control-plane ownership, free-first task-class routing, plan-first packets, context budgets, and session compaction governance."
    },
    {
      "date": "2026-05-27",
      "summary": "Aegis vNext v2 baseline policy."
    }
  ],
  "controlPlane": {
    "authoritativeFiles": [
      ".github/copilot-instructions.md",
      "AGENTS.md",
      ".github/instructions/agentic-workflow.instructions.md",
      "scripts/orchestrator/policy.json"
    ],
    "ownership": {
      ".github/copilot-instructions.md": "engineering-and-model-usage-rules",
      "AGENTS.md": "roster-routing-and-operating-lanes",
      ".github/instructions/agentic-workflow.instructions.md": "handoff-contract-and-dispatch-shape",
      "scripts/orchestrator/policy.json": "machine-readable-runtime-truth"
    },
    "changeControl": {
      "requireVersionBump": true,
      "requireChangelogEntry": true,
      "validationCommands": [
        "npm run plans:validate",
        "npm run aegis:health",
        "npm run aegis:context:validate"
      ],
      "forbidSilentDrift": true
    }
  },
  "planFirst": {
    "enabled": true,
    "defaultMode": "plan-before-agent",
    "trivialExemptions": ["formatting-only", "comment-only", "small-doc-fix"],
    "requiredPlanPacketFields": [
      "goal",
      "filesInScope",
      "validationPath",
      "recommendedModelTier",
      "contextSizeExpectation"
    ],
    "enforceBeforePremiumExecution": true
  },
  "contextBudget": {
    "enabled": true,
    "defaultMaxFiles": 12,
    "defaultMaxInstructionFiles": 4,
    "defaultMaxWaveBundles": 1,
    "defaultMaxBusinessDocSections": 6,
    "warnAfterTurns": 16,
    "hardStopAfterTurns": 28,
    "warnAfterApproxTokens": 120000,
    "hardStopAfterApproxTokens": 220000,
    "preferStructuredSummaries": true,
    "agentTierBudgetKB": {
      "free": 32,
      "premium": 128,
      "description": "Per-turn file-read budget in KB per agent tier. Agent-loop scripts must check this before opening files."
    }
  },
  "sessionManagement": {
    "oneObjectivePerSession": true,
    "oneWaveOrBugFamilyPerSession": true,
    "mandatoryEndOfSessionSummary": true,
    "requireCarryForwardList": true,
    "newChatTriggers": [
      "objective-changed",
      "file-scope-widened",
      "turn-threshold-exceeded",
      "handoff-no-longer-compact"
    ]
  },
  "historyManagement": {
    "enabled": true,
    "layers": ["raw-logs", "session-snapshot", "handoff-summary"],
    "reuseLayer": "handoff-summary",
    "markStaleAsNonCanonical": true,
    "bootstrapFromMinimalPacket": true
  }
}
