{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Doc Readiness Packet",
  "type": "object",
  "required": [
    "artifactId",
    "readinessScore",
    "evidence",
    "validation",
    "status"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "wave": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "ready",
        "approved",
        "blocked"
      ]
    },
    "readinessScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
